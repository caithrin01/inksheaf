---
import Logo from "../components/Logo.astro";
import "../styles/workflow.css";
// "Change something", from the proof email (plan-end-to-end-v1, phase 2 and 5). The writer
// leaves posts out, retitles a volume, switches to another set the editor offered, switches
// the interior, adds a dedication; the plan is re-derived from the archive, checked against
// the cap, saved, and a new proof is started. Anything else goes to a person in their words.
---
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Change something · Inksheaf</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="robots" content="noindex" /></head>
<body><main class="workflow-sheet"><a href="/" class="workflow-home" aria-label="Inksheaf home"><Logo small /></a>
<p class="eyebrow">Inksheaf · your edition</p>
<h1>Change something</h1>
<p id="lead" class="note" role="status">Loading your plan…</p>
<section id="work" hidden>
  <h2>The set</h2>
  <div class="routes" id="routes"></div>
  <h2>The volumes</h2>
  <p class="note">Untick a post to leave it out. Rename a volume by typing over its title.</p>
  <div id="vols"></div>
  <h2>Interior</h2>
  <div class="interior"><label><input type="radio" name="interior" value="bw" /> Black and white</label><label><input type="radio" name="interior" value="color" /> Colour</label></div>
  <h2>Left out</h2>
  <p class="note" id="leftnote">Pieces the rules or the editor left out, each with the reason. Tick one to bring it back.</p>
  <div class="posts" id="left"></div>
  <h2><label for="isbn">ISBN</label></h2>
  <p class="note">Optional. Your own ISBN, ten or thirteen digits; it goes on the copyright page and as a barcode on the back cover. Leave it empty to print without one.</p>
  <input id="isbn" type="text" maxlength="20" inputmode="numeric" placeholder="978-…" style="width:100%;font:inherit;padding:.4rem .5rem;background:var(--card);color:var(--ink);border:1px solid var(--hair)" />
  <h2><label for="ded">Dedication</label></h2>
  <p class="note">One line, printed on its own page before the contents. Leave it empty for none.</p>
  <input id="ded" type="text" maxlength="200" style="width:100%;font:inherit;padding:.4rem .5rem;background:var(--card);color:var(--ink);border:1px solid var(--hair)" />
  <p class="sum" id="sum"></p>
  <button type="button" id="apply">Apply and send a new proof</button>
  <button type="button" class="ghost" id="other">Something else</button>
  <div class="err" id="err" role="alert"></div>
  <form id="f" hidden>
    <h2>Tell us in your words</h2>
    <textarea aria-label="Requested changes" id="req" required placeholder="Move the March essays into the spring volume and call it ‘Spring’."></textarea>
    <button type="submit">Send the changes</button>
  </form>
  <p class="note" id="done" hidden></p>
</section>
</main>
<script>
const q = new URLSearchParams(location.search); const id = q.get('id'), sig = q.get('sig');
const $ = (s) => document.querySelector(s);
const NAME = { single: 'One volume', half: 'Half-year set', quarterly: 'Quarterly', monthly: 'Monthly' };
let plan = null, titles = {}, routes = null, leftOut = [], isbn = null;
const money = n => '$' + Number(n).toFixed(2);
function render() {
  const rs = $('#routes');
  if (routes && routes.length > 1) rs.innerHTML = routes.map(r => `<label><input type="radio" name="cadence" value="${r.cadence}" ${r.cadence === plan.cadence ? 'checked' : ''} /> ${NAME[r.cadence] || r.cadence} · ${r.volumes.length === 1 ? r.volumes[0].est_pages + ' pages' : r.volumes.length + ' volumes'} · ${money(r.price ? r.price[plan.interior] : 0)}${r.recommended ? ' · the editor’s pick' : ''}</label>`).join('');
  else rs.innerHTML = `<p class="note">${NAME[plan.cadence] || plan.cadence}. No other set was offered for this archive.</p>`;
  $('#vols').innerHTML = plan.volumes.map((v, i) => `<div class="vol" data-i="${i}"><div class="head"><b>${v.label}</b><span class="note">${v.posts ?? v.post_ids.length} posts · ${v.est_pages ?? '?'}pp</span></div>
    <input class="title" aria-label="Volume title" name="title" data-label="${v.label}" value="${(v.title || '').replace(/"/g, '&quot;')}" placeholder="Volume title" />
    <div class="posts">${v.post_ids.map(pid => { const t = titles[pid] || {}; return `<label><input type="checkbox" name="keep" value="${pid}" checked /><span class="d">${t.date || ''}</span><span>${(t.title || 'Post ' + pid).replace(/</g, '&lt;')}</span></label>`; }).join('')}</div></div>`).join('');
  document.querySelector(`input[name=interior][value=${plan.interior === 'color' ? 'color' : 'bw'}]`).checked = true;
  $('#ded').value = plan.dedication || '';
  $('#isbn').value = isbn || '';
  $('#left').innerHTML = leftOut.length ? leftOut.map(x => `<label><input type="checkbox" name="include" value="${x.slug}" ${x.included ? 'checked' : ''} /><span class="d">${x.kind === 'guest' ? 'guest' : x.kind === 'editor' ? 'editor' : 'rule'}</span><span>${(x.title || x.slug).replace(/</g, '&lt;')}<span class="note"> · ${String(x.reason).replace(/</g, '&lt;')}</span></span></label>`).join('') : `<p class="note">Nothing was left out.</p>`;
  if (!leftOut.length) $('#leftnote').hidden = true;
  $('#vols').addEventListener('change', e => { if (e.target.name === 'keep') e.target.closest('label').classList.toggle('out', !e.target.checked); summarize(); });
  $('#routes').addEventListener('change', summarize); document.querySelector('.interior').addEventListener('change', summarize);
  summarize();
}
function summarize() {
  const excluded = [...document.querySelectorAll('input[name=keep]:not(:checked)')].length;
  const cadence = (document.querySelector('input[name=cadence]:checked') || {}).value || plan.cadence;
  const interior = document.querySelector('input[name=interior]:checked').value;
  $('#sum').textContent = `${NAME[cadence] || cadence}, ${interior === 'color' ? 'colour' : 'black and white'}${excluded ? ', ' + excluded + ' post' + (excluded === 1 ? '' : 's') + ' left out' : ''}. Pages and prices are re-derived when you apply; nothing prints until you approve the new proof.`;
}
(async () => {
  const r = await fetch(`/api/change?id=${encodeURIComponent(id || '')}&sig=${encodeURIComponent(sig || '')}`);
  const d = await r.json().catch(() => ({}));
  if (!d.ok) { $('#lead').textContent = 'That link is not valid. Open it from your proof email again, or write to caithrin@caithrin.com.'; return; }
  plan = d.plan; titles = d.titles || {}; routes = d.routes; leftOut = d.left_out || []; isbn = d.isbn || null;
  $('#lead').textContent = `${d.publication_url.replace(/^https?:\/\//, '')} · ${d.status}`;
  if (!plan || !Array.isArray(plan.volumes) || !plan.volumes.length) { $('#lead').textContent += ' · planned by hand: tell us below what should change.'; $('#work').hidden = false; $('#apply').hidden = true; $('#other').hidden = true; $('#f').hidden = false; document.querySelectorAll('#work h2, #routes, #vols, .interior, #ded, #sum, .note').forEach(el => { if (!el.closest('#f')) el.hidden = true; }); return; }
  $('#work').hidden = false; render();
})();
$('#apply').addEventListener('click', async () => {
  const exclude = [...document.querySelectorAll('input[name=keep]:not(:checked)')].map(i => Number(i.value));
  const titlesOut = {}; for (const i of document.querySelectorAll('input.title')) if (i.value.trim()) titlesOut[i.dataset.label] = i.value.trim();
  const cadence = (document.querySelector('input[name=cadence]:checked') || {}).value || plan.cadence;
  const interior = document.querySelector('input[name=interior]:checked').value;
  const include = [...document.querySelectorAll('input[name=include]:checked')].map(i => i.value);
  const isbnOut = $('#isbn').value.trim();
  $('#apply').disabled = true; $('#err').textContent = '';
  const r = await fetch('/api/change', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id, sig, changes: { exclude, include, isbn: isbnOut, titles: titlesOut, cadence: cadence !== plan.cadence ? cadence : null, interior, dedication: $('#ded').value.trim() } }) });
  const d = await r.json().catch(() => ({}));
  if (!d.ok) { $('#apply').disabled = false; $('#err').textContent = d.error || 'That did not apply.'; return; }
  $('#work').querySelectorAll('h2, #routes, #vols, #left, #isbn, .interior, #ded, #sum, #apply, #other, .note').forEach(el => el.hidden = true);
  $('#done').hidden = false;
  $('#done').textContent = d.reproof === 'started' ? 'Applied. A new proof is being made and lands in your inbox in a few minutes: ' + d.plan.volumes.map(v => v.label + ' ' + v.est_pages + 'pp').join(', ') + '.' : 'Applied. A person makes the new proof and emails it to you today: ' + d.plan.volumes.map(v => v.label + ' ' + v.est_pages + 'pp').join(', ') + '.';
});
$('#other').addEventListener('click', () => { $('#f').hidden = false; $('#req').focus(); });
$('#f').addEventListener('submit', async (e) => {
  e.preventDefault();
  const r = await fetch('/api/change', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id, sig, request: $('#req').value }) });
  if (r.ok) { $('#f').hidden = true; $('#done').hidden = false; $('#done').textContent = 'Got it. A person applies your changes, re-proofs the edition, and emails you the new pages, usually the same day.'; }
  else $('#err').textContent = 'That did not send. Reply to your proof email instead.';
});
</script></body></html>
