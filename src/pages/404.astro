---
// Real 404 so Cloudflare Pages stops SPA-fallbacking every path to index.html.
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>404 — Inksheaf</title>
<meta name="robots" content="noindex" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,300..700&display=swap" rel="stylesheet" />
<style>
:root{--paper:#f7f2e8;--ink:#221d16;--rubric:#a63a2b;--faint:rgba(34,29,22,.6)}
@media (prefers-color-scheme:dark){:root{--paper:#181511;--ink:#e9e2d3;--rubric:#d0604e;--faint:rgba(233,226,211,.62)}}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"Source Serif 4",Georgia,serif;
  min-height:100vh;display:grid;place-items:center;text-align:center;padding:2rem}
h1{font-size:4rem;font-weight:560;margin:0 0 .5rem;color:var(--rubric)}
p{margin:.3rem 0;color:var(--faint)}
a{color:var(--rubric)}
</style>
</head>
<body>
<div>
  <h1>404</h1>
  <p>This page is not in the edition.</p>
  <p><a href="/">Back to inksheaf.com</a></p>
</div>
</body>
</html>
