  const why = uneven && /balanc|evenly|equal/i.test(route.why)
    ? route.volumes.length + ' volumes, from ' + Math.min(...routePages) + ' to ' + Math.max(...routePages) + ' pages.' : sentence(route.why);
  document.getElementById('route-why')!.textContent = (route.recommended ? 'Our recommendation. ' : '') + why;
  const bar = document.getElementById('foliobar')!;
  bar.innerHTML = '';
  route.volumes.forEach((v: any, i: number) => {
    const seg = document.createElement('div'); seg.className = 'folio-seg'; seg.setAttribute('role','listitem');
    const price = v.price[plan.interior];
