    b.appendChild(document.createTextNode(CAD_NAME[key]));
    if (r){
      const sub = document.createElement('span'); sub.className = 'sub'; sub.setAttribute('aria-hidden', 'true');
      const inParts = r.volumes.some((v: any) => /\s·\s[IVX]+$/.test(v.label));
