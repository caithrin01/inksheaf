function renderDesk(d: any){
  if (d.editorial && d.editorial.plan) return renderPlan(d);
  plan = null;
  for (const id of ['plan-what','route-why','plan-progress','interior-why','plan-by']) document.getElementById(id)!.textContent = '';
  const el = document.getElementById('desk') as HTMLElement;
  const reason = document.getElementById('pv-reason') as HTMLElement;
  if (!d.divisions || !d.recommended){
    el.hidden = true; reason.textContent = '';
    (document.getElementById('pv-price') as HTMLElement).innerHTML =
      'Estimated printing: <b>about $' + Math.round(priceFor(d.est_pages, 'bw')) + '</b>' +
      '<span class="sub">Shipping and tax are calculated by Lulu.</span>';
    return;
  }
  const feasible = ['single','quarterly','monthly'].filter(k => d.divisions[k] && d.divisions[k].feasible);
  const startCadence = d.divisions[d.recommended.cadence] && d.divisions[d.recommended.cadence].feasible
    ? d.recommended.cadence : feasible[0];
  desk = { cadence: startCadence, interior: d.recommended.interior, d };
  el.hidden = false;
  if (!startCadence){
    document.getElementById('desk-tabs')!.innerHTML = '';
