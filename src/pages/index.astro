/* The calendar plan paints first. When the deploy has an editor, ask it in a second request
   (15 to 100 s of model time) and swap its plan onto the shelf when it lands; the shelf says
   which plan it is showing the whole time. A failure leaves the calendar plan in place. */
let editorAsk: string | null = null;
async function askTheEditor(d: any){
  const ed = d.editorial;
  if (!ed || !ed.pending || ed.planned_by === 'editor') return;
  const host = d.host; editorAsk = host;
  const by = document.getElementById('plan-by') as HTMLElement;
  by.textContent = 'Planned by the calendar · our editor is reading your archive';
  const started = Date.now();
  while (Date.now() - started < 150000 && editorAsk === host){
    try {
      const r = await fetch('/api/plan?url=' + encodeURIComponent('https://' + host));
      if (r.status === 404) break;
      const j = await r.json();
      if (!j.ok) break;
      if (j.served !== 'pending' && j.editorial){
        if (editorAsk !== host || !previewData || previewData.host !== host) return;
        previewData.editorial = j.editorial;
        if (j.editorial.plan && Array.isArray(j.editorial.plan.routes)){
          renderPlan(previewData);
          refreshCapturedReservation();
          announceEdition(previewData, editionView(previewData, plan.cadence), 'Our editor has planned your edition: ');
        }
        return;
      }
      await new Promise(res => setTimeout(res, (j.retry_in || 4) * 1000));
    } catch { break; }
  }
  if (editorAsk === host) by.textContent = 'Planned by the calendar';
}
/* A successful request navigates once to the edition. The short reveal supplies the transition;
   do not combine it with a long animated scroll through the preceding desk scene. */
function revealBook(d: any){
  const bw = document.getElementById('bookwrap') as HTMLElement;
  announceEdition(d, editionView(d, plan?.cadence));
  bw.focus({ preventScroll: true });
  bw.scrollIntoView({ behavior: 'instant', block: 'start' });
}

/* ---------- the composing desk: all the math done, defaults pre-set ---------- */
const PRICES = JSON.parse(document.getElementById('print-prices')!.textContent!);
let desk: any = null;
const CAD_LABEL: any = { single: 'One volume', quarterly: 'Quarterly', monthly: 'Monthly' };
function priceFor(pages: number, interior: string){
  const c = PRICES[interior === 'color' ? 'color' : 'bw'];
  return c.base + c.per_page * pages;
}
function unitOf(d: any, n: number){ return (d.unit || 'volume') + (n === 1 ? '' : 's'); }
function shipFor(n: number){
  const pts = Object.entries(PRICES.shipping_set || {}).map(([k, v]) => [Number(k), Number(v)]);
  if (!pts.length) return PRICES.shipping;
  const exact = pts.find(([k]) => k === n);
  if (exact) return exact[1];
  /* least-squares line through the measured points; shipping scales near-linearly per volume */
  const m = pts.length, sx = pts.reduce((a, [x]) => a + x, 0), sy = pts.reduce((a, [, y]) => a + y, 0);
  const sxx = pts.reduce((a, [x]) => a + x * x, 0), sxy = pts.reduce((a, [x, y]) => a + x * y, 0);
  const slope = (m * sxy - sx * sy) / (m * sxx - sx * sx), base = (sy - slope * sx) / m;
  return Math.max(PRICES.shipping, base + slope * n);
}
function aUnit(d: any){ const u = d.unit || 'volume'; return (/^[aeiou]/.test(u) ? 'an ' : 'a ') + u; }
/* ---------- the plan screen: the editor's plan on a shelf ---------- */
const CAD_NAME: any = { single: 'One volume', half: 'Half-year set', quarterly: 'Quarterly', monthly: 'Monthly' };
const ROMAN = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'];
let plan: any = null;
function money(n: number){ return '$' + n.toFixed(2); }
function renderPlan(d: any){
  const ed = d.editorial, P = ed.plan;
  const el = document.getElementById('desk') as HTMLElement;
  const reason = document.getElementById('pv-reason') as HTMLElement;
  el.hidden = false;
  desk = null;
  const golden = P.routes.find((r: any) => r.recommended) || P.routes[0];
  const previous = plan?.d.host === d.host ? plan : null;
  plan = { d, ed, P, cadence: previous && P.routes.some((r: any) => r.cadence === previous.cadence) ? previous.cadence : (golden ? golden.cadence : null),
    interior: previous?.interior || (P.interior.recommended === 'color' ? 'color' : 'bw') };
  reason.textContent = 'What you write: ' + P.kind + (P.rhythm ? ' · ' + P.rhythm : '');
  (document.getElementById('plan-what') as HTMLElement).textContent = P.description;
  if (!golden){
    paintCover(d, editionView(d));
    document.getElementById('pv-kind')!.textContent = 'Hand-built edition';
    document.getElementById('pv-cvpages')!.textContent = 'Binding to be planned';
    document.getElementById('pv-big')!.textContent = 'This edition needs a hand plan.';
    document.getElementById('pv-sub')!.textContent = 'Your archive does not divide into the available bindings. We will plan the volumes with you.';
    document.getElementById('plan-what')!.textContent = '';
    document.getElementById('pv-cta')!.textContent = 'Request a hand-built proof';
    for (const id of ['plan-progress','interior-why','plan-by']) document.getElementById(id)!.textContent = '';
    document.getElementById('desk-tabs')!.innerHTML = '';
    document.getElementById('foliobar')!.innerHTML = '';
    document.getElementById('interior-row')!.innerHTML = '';
    (document.getElementById('pv-price') as HTMLElement).textContent = '';
    (document.getElementById('route-why') as HTMLElement).textContent = '';
    document.getElementById('desk-verdict')!.textContent =
      'This archive does not divide cleanly on its own; reserve a spot and we will plan the volumes by hand.';
    return;
  }
  drawPlan();
}
function drawPlan(){
  const activeGroup = document.activeElement?.parentElement?.id;
  const { d, ed, P } = plan;
  const route = P.routes.find((r: any) => r.cadence === plan.cadence);
  const tabs = document.getElementById('desk-tabs')!;
  tabs.innerHTML = '';
  for (const key of ['single','half','quarterly','monthly']){
    const r = P.routes.find((x: any) => x.cadence === key);
    const inf = P.infeasible.find((x: any) => x.cadence === key);
    if (!r && !inf) continue;
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'desk-tab'; b.setAttribute('role','tab');
