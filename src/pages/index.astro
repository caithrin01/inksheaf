}
function updateCoverFromDesk(d: any, div: any){
  const n = div.volumes.length;
  const year = d.to.slice(0, 4);
  const kindTitle = (d.kind || 'collected').charAt(0).toUpperCase() + (d.kind || 'collected').slice(1);
  (document.getElementById('pv-kind') as HTMLElement).textContent =
    desk.cadence === 'single'
    ? (d.young ? kindTitle : 'Annual') + ' · ' + year
    : (desk.cadence === 'quarterly' ? 'Quarterly' : 'Monthly') + ' · ' + year;
  const publicPosts = d.public_posts ?? d.posts;
  (document.getElementById('pv-cvpages') as HTMLElement).textContent = n > 1
    ? 'Vol. I of ' + n + ' · ' + div.volumes[0].est_pages + ' pages'
    : publicPosts + (d.capped ? '+' : '') + ' ' + kindLabel(d, publicPosts) + ' · est. ' + div.volumes[0].est_pages + ' pages';
}
document.getElementById('desk-tabs')!.addEventListener('keydown', event => {
  const keys = ['ArrowLeft','ArrowRight','Home','End'];
  if (!keys.includes(event.key)) return;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#desk-tabs button:not(:disabled)')];
  if (!tabs.length) return;
  event.preventDefault();
  const current = tabs.indexOf(event.target as HTMLButtonElement);
  const index = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 :
    (current + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
  tabs[index].click();
  (document.querySelector('#desk-tabs [aria-selected="true"]') as HTMLElement)?.focus({preventScroll:true});
});
function renderSnippet(d: any){
  const wrap = document.getElementById('snippet') as HTMLElement;
  if (!wrap) return;
  wrap.hidden = false;
  (document.getElementById('snip-code') as HTMLElement).textContent =
    '<a href="https://inksheaf.com/?pub=' + d.host + '">Preview a print edition of ' + d.publication + '</a>';
}
document.getElementById('fb-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.currentTarget as HTMLFormElement, btn = document.getElementById('fb-send') as HTMLButtonElement, st = document.getElementById('fb-status') as HTMLElement;
  const text = (document.getElementById('fb-text') as HTMLTextAreaElement).value.trim();
  if (text.length < 3) { st.textContent = 'Say a little more; even one sentence helps.'; return; }
  btn.disabled = true; st.textContent = 'Sending.';
  try {
    const r = await fetch('/api/feedback', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({
      text, email: (document.getElementById('fb-email') as HTMLInputElement).value.trim(), website: (form.querySelector('.fb-hp') as HTMLInputElement).value,
      publication: previewData ? previewData.host : '', page: location.pathname + location.search }) });
    const j = await r.json().catch(() => ({}));
    if (r.ok && j.ok) { st.textContent = 'Kept. Thank you; it is read by a person.'; form.reset(); beacon('feedback'); }
    else st.textContent = j.error || 'Could not save that just now. Write to caithrin@caithrin.com and it reaches the same place.';
  } catch { st.textContent = 'Could not reach us just now. Write to caithrin@caithrin.com and it reaches the same place.'; }
  btn.disabled = false;
});
document.getElementById('snip-copy')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget as HTMLButtonElement;
  try {
    await navigator.clipboard.writeText(document.getElementById('snip-code')!.textContent || '');
    btn.textContent = 'Copied'; setTimeout(() => { btn.textContent = 'Copy the code'; }, 1600);
  } catch { btn.textContent = 'Select and copy above'; }
});
function kindLabel(d: any, count: number){
  if (count === 1) return d.noun || 'piece';
  return d.kind || ((d.noun || 'piece') + 's');
}
function fmt(iso: string){
  return new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', {month:'short', year:'numeric', timeZone:'UTC'});
}
trybtn.addEventListener('click', ()=>runPreview());
tryurl.addEventListener('keydown', (e)=>{ if (e.key==='Enter'){ e.preventDefault(); runPreview(); } });
{ /* a preview someone shares reproduces itself */
  const pub = new URLSearchParams(location.search).get('pub');
  if (pub && /^[a-z0-9.-]+$/i.test(pub)){ tryurl.value = 'https://' + pub; runPreview(); }
}

tryhandoff.addEventListener('click', ()=>{
  clearPreview();
  const raw = tryurl.value.trim();
  if (raw) (f.elements.namedItem('publication_url') as HTMLInputElement).value =
    raw.startsWith('http') ? raw : 'https://' + raw;
  document.getElementById('carried')!.textContent =
    'We will build this preview by hand. Leave one email for the proof pages.';
  show(2);
  document.getElementById('beta')!.scrollIntoView({behavior:'smooth', block:'start'});
});

function captureReservation(){
  const d = previewData;
  if (d && plan && plan.P){
    const route = plan.P.routes.find((r: any) => r.cadence === plan.cadence);
    (f.elements.namedItem('cadence_pref') as HTMLInputElement).value = plan.cadence || 'concierge';
    (f.elements.namedItem('plan_json') as HTMLInputElement).value = JSON.stringify({
      plan_version: plan.ed.plan_version, planned_by: plan.ed.planned_by, cadence: plan.cadence || 'concierge', interior: plan.interior,
      window: plan.ed.window ? { label: plan.ed.window.label, from: plan.ed.window.from, to: plan.ed.window.to } : null,
      kind: plan.P.kind, running_head: plan.P.running_head, dedication_post_id: plan.P.dedication_post_id,
      contributors: plan.P.contributors, excluded: plan.P.excluded,
      volumes: route ? route.volumes.map((v: any) => ({ label: v.label, title: v.title, subtitle: v.subtitle, notes_policy: v.notes_policy, parts: v.parts, est_pages: v.est_pages, posts: v.posts, price: v.price, post_ids: v.post_ids })) : [],
      needs_hand_plan: !route || undefined, form: d.form, unit: d.unit, prices_measured: PRICES.measured });
  } else if (d && desk && d.divisions){
    const div = desk.cadence && d.divisions[desk.cadence];
    (f.elements.namedItem('cadence_pref') as HTMLInputElement).value = desk.cadence || 'concierge';
    (f.elements.namedItem('plan_json') as HTMLInputElement).value = JSON.stringify({
      cadence: desk.cadence || 'concierge', interior: desk.interior,
      volumes: div && div.feasible ? div.volumes : [],
      needs_hand_plan: !(div && div.feasible) || undefined,
      form: d.form, unit: d.unit, prices_measured: PRICES.measured });
  }
  if (d){
    (f.elements.namedItem('publication_url') as HTMLInputElement).value = 'https://' + d.host;
    const publicPosts = d.public_posts ?? d.posts;
    (f.elements.namedItem('posts_per_year') as HTMLInputElement).value = String(publicPosts);
    (f.elements.namedItem('frequency') as HTMLInputElement).value =
      publicPosts >= 200 ? 'daily' : publicPosts >= 40 ? 'weekly' : publicPosts >= 10 ? 'monthly' : 'irregular';
    const selected = editionView(d, plan?.cadence || desk?.cadence);
    const chosenPages = selected.pages, chosenPosts = selected.posts;
    document.getElementById('carried')!.textContent =
      d.publication + ' · ' + chosenPosts + ' pieces in the chosen set · about ' + chosenPages + ' pages, estimated until the proof is typeset. Leave one email for the proof.';
  }
}
function reservationMatchesPreview(){
  if (!previewData) return false;
  try { return new URL((f.elements.namedItem('publication_url') as HTMLInputElement).value).hostname.toLowerCase() === previewData.host.toLowerCase(); }
  catch { return false; }
}
function refreshCapturedReservation(){
  if (!reservationPending && f.style.display !== 'none' && (f.querySelector('.step2') as HTMLElement).style.display === 'block' && reservationMatchesPreview()) captureReservation();
}
(document.getElementById('pv-cta') as HTMLButtonElement).addEventListener('click', ()=>{
  captureReservation(); show(2);
  document.getElementById('beta')!.scrollIntoView({behavior:'smooth'});
});

/* ---------- funnel ---------- */
f.addEventListener('keydown', (e)=>{
  if (e.key !== 'Enter') return;
  const target = e.target as HTMLElement;
  if (target.tagName === 'BUTTON' || target.tagName === 'SELECT') return;
  const current = [1,2].find(k => (f.querySelector('.step'+k) as HTMLElement).style.display !== 'none');
  if (current && current < 2){
    e.preventDefault();
    (f.querySelector('.step'+current+' [data-next]') as HTMLElement)?.click();
  }
});
f.addEventListener('click', (e)=>{
  const t = e.target as HTMLElement;
  const next = t.dataset?.next, back = t.dataset?.back;
  if (back) return show(+back);
  if (!next) return;
  if (next==='2'){
    const u = (f.elements.namedItem('publication_url') as HTMLInputElement).value.trim();
    try { new URL(u.startsWith('http')?u:'https://'+u); } catch {
      document.getElementById('err')!.textContent = 'That does not look like a URL.';
      return;
    }
    if (!u.startsWith('http')) (f.elements.namedItem('publication_url') as HTMLInputElement).value = 'https://'+u;
  }
  show(+next);
});
let reservationPending = false;
f.addEventListener('submit', async (e)=>{
  e.preventDefault();
  if (reservationPending) return;
  const email = (f.elements.namedItem('email') as HTMLInputElement).value.trim();
  const err = document.getElementById('err')!;
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){
    err.textContent = 'That email does not look right.';
    return;
  }
  if (reservationMatchesPreview()) captureReservation();
  editorAsk = null;
  if (previewData?.editorial?.planned_by === 'calendar') document.getElementById('plan-by')!.textContent = 'Planned by the calendar';
  reservationPending = true;
  const submit = f.querySelector('button[type="submit"]') as HTMLButtonElement;
  submit.disabled = true; submit.textContent = 'Reserving…';
  f.setAttribute('aria-busy', 'true'); err.textContent = '';
  const data = { ...Object.fromEntries(new FormData(f).entries()), session: sid };
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 30000);
  try {
    const r = await fetch('/api/signup', {method:'POST', signal:controller.signal,
      headers:{'content-type':'application/json'}, body: JSON.stringify(data)});
    const j = await r.json();
    if (!r.ok || !j.ok) throw new Error('Reservation not confirmed');
    (f as HTMLElement).style.display='none';
    (document.querySelector('.steps') as HTMLElement).style.display='none';
    const done = document.getElementById('done')!;
    done.style.display='block';
    document.getElementById('done-h')!.textContent = 'Your print run is reserved.';
    document.getElementById('done-verify')!.textContent = 'We have your request. Use the confirmation link in your publication’s inbox if you have one, or write to caithrin@caithrin.com for help or changes.';
    if (j.press === 'verify' && j.sent_to) {
      document.getElementById('done-h')!.textContent = 'Your print run is reserved. One more step: confirm from your publication’s inbox.';
      document.getElementById('done-verify')!.replaceChildren(document.createTextNode('We sent a confirmation link to '), Object.assign(document.createElement('b'), { id:'done-to', textContent:j.sent_to }), document.createTextNode('. Open it to confirm ownership and prepare your proof. Nothing prints until you approve it.'));
      document.getElementById('done-to')!.textContent = j.sent_to;
      aboutFallback(j.id, 10 * 60 * 1000);
    } else if (j.press === 'verify') {
      document.getElementById('done-h')!.textContent = 'Reserved, and one more step.';
      document.getElementById('done-verify')!.textContent = 'We could not send your confirmation. Prove ownership with a code on your About page below, or write to caithrin@caithrin.com.';
      aboutFallback(j.id, 0);
    } else if (j.press === 'test') {
      document.getElementById('done-h')!.textContent = 'Test reservation recorded.';
      document.getElementById('done-verify')!.textContent = 'No confirmation is sent for a test address.';
    }
    done.setAttribute('tabindex', '-1'); done.focus();
  } catch {
    err.textContent = 'We could not confirm your reservation. Your details are still here; try again, or email caithrin@caithrin.com.';
  } finally {
    clearTimeout(timeout); reservationPending = false;
    submit.disabled = false; submit.textContent = 'Request a spot';
    f.removeAttribute('aria-busy');
    if (f.style.display !== 'none' && previewData) askTheEditor(previewData);
  }
});
/* The About-page fallback (P0-8): after `delay` ms without the confirmation link, offer the code. */
function aboutFallback(id: number, delay: number){
  if (!id) return;
  const alt = document.getElementById('done-alt')!, start = document.getElementById('alt-start')!, text = document.getElementById('alt-text')!;
  const code = document.getElementById('alt-code')!, check = document.getElementById('alt-check') as HTMLButtonElement, result = document.getElementById('alt-result')!;
  if (aboutTimer) clearTimeout(aboutTimer);
  aboutTimer = setTimeout(() => { alt.style.display = 'block'; }, delay);
  start.removeAttribute('disabled'); start.style.display = 'block';
  text.style.display = 'none'; check.style.display = 'none'; check.disabled = false; result.textContent = '';
  code.textContent = '';
  const post = (body: object) => fetch('/api/verify-about', {method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify(body)}).then(r => r.json());
  (start as HTMLButtonElement).onclick = async () => {
    start.setAttribute('disabled', ''); result.textContent = '';
    try { const j = await post({signup_id: id}); if (!j.ok) { result.textContent = j.error || 'That did not work. Write to caithrin@caithrin.com.'; start.removeAttribute('disabled'); return; }
      code.textContent = j.code; text.style.display = 'block'; check.style.display = 'inline-block'; start.style.display = 'none';
    } catch { result.textContent = 'That did not work. Write to caithrin@caithrin.com.'; start.removeAttribute('disabled'); }
  };
  check.onclick = async () => {
    check.disabled = true; result.textContent = 'Checking your About page.';
    try { const j = await post({signup_id: id, check: true});
      if (j.ok && j.verified) { result.textContent = j.press === 'dispatched' ? 'Confirmed. The proof is being made; the email comes when it is ready.' : 'Confirmed. The press is queued; the email comes when the proof is ready.'; text.style.display = 'none'; check.style.display = 'none'; }
      else { result.textContent = j.message || j.error || 'Not there yet. Try again in a minute.'; check.disabled = false; }
    } catch { result.textContent = 'The check failed on our side. Try again in a minute.'; check.disabled = false; }
  };
}
