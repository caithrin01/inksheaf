<script>
const f = document.getElementById('f') as HTMLFormElement;
const sid = Math.random().toString(36).slice(2,10);
const seen = new Set();
function beacon(ev: string){
  if (seen.has(ev)) return; seen.add(ev);
  navigator.sendBeacon?.('/api/event', new Blob(
    [JSON.stringify({session:sid, event:ev})], {type:'application/json'}));
}
beacon('view');
function show(n: number){
  for (const k of [1,2]) (f.querySelector('.step'+k) as HTMLElement).style.display = (k===n?'block':'none');
  document.getElementById('stepnum')!.textContent = String(n);
  document.getElementById('err')!.textContent = '';
  if (n>1) beacon('step'+n);
}
show(1);

/* ---------- live preview ---------- */
const trybtn = document.getElementById('trybtn') as HTMLButtonElement;
const tryurl = document.getElementById('tryurl') as HTMLInputElement;
const tryerr = document.getElementById('tryerr')!;
const tryhandoff = document.getElementById('tryhandoff') as HTMLButtonElement;
let previewData: any = null;

/* ---------- typesetting interlude: facts fade through while the press runs ---------- */
const stage = document.getElementById('pv-stage')!;
const setline = document.getElementById('pv-setline')!;
let lastShownHost: string | null = null;
const motionOK = !matchMedia('(prefers-reduced-motion: reduce)').matches;
async function beat(html: string, hold = 620){
  setline.classList.remove('in'); setline.classList.add('out');
  await new Promise(r => setTimeout(r, 230));
  setline.innerHTML = html;
  setline.classList.remove('out'); setline.classList.add('in');
  await new Promise(r => setTimeout(r, 290 + hold));
}
function interludeStart(){
  if (!motionOK) return false;
  const pv = document.getElementById('preview')!;
  pv.classList.remove('on'); pv.classList.add('staging');
  setline.innerHTML = 'Reading your archive&hellip;';
  setline.classList.add('in');
  stage.classList.add('on');
  return true;
}
async function interludeFacts(d: any){
  const mon = (iso: string) => new Date(iso + 'T00:00:00Z')
    .toLocaleDateString('en-US', {month:'long', year:'numeric', timeZone:'UTC'});
  const count = d.public_posts ?? d.posts;
  const noun = d.noun || 'essay';
  await beat('<b>' + count + '</b> ' + kindLabel(d, count) + '.');
  await beat('<b>' + d.words.toLocaleString('en-US') + '</b> words.');
  await beat(mon(d.from) + ' &ndash; ' + mon(d.to) + '.');
  await beat('That is <b>' + d.est_pages + ' pages</b>: ' + (d.form || 'a book') + '.', 700);
  const recDiv = d.divisions && d.recommended && d.divisions[d.recommended.cadence];
  if (recDiv && recDiv.volumes.length > 1)
    await beat('Divided into <b>' + recDiv.volumes.length + '</b> ' + (d.unit || 'volume') + 's.', 780);
  stage.classList.remove('on');
  setline.classList.remove('in');
  document.getElementById('preview')!.classList.remove('staging');
}

async function runPreview(){
  const raw = tryurl.value.trim();
  if (!raw){ tryerr.textContent = 'Paste your publication URL first.'; return; }
  tryerr.textContent = '';
  tryhandoff.hidden = true;
  trybtn.disabled = true; trybtn.textContent = 'Typesetting…';
  const interludeOn = !!tryurl.value && raw !== lastShownHost ? interludeStart() : false;
  try {
    const r = await fetch('/api/preview?url=' + encodeURIComponent(raw));
    const d = await r.json();
    if (!d.ok){
      (f.elements.namedItem('publication_url') as HTMLInputElement).value =
        raw.startsWith('http') ? raw : 'https://' + raw;
      stage.classList.remove('on');
      document.getElementById('preview')!.classList.remove('staging');
      document.getElementById('preview')!.classList.remove('personalized');
      document.getElementById('preview')!.classList.add('on');
      tryerr.textContent = d.message || 'Could not read that archive.';
      tryhandoff.hidden = false;
      return;
    }
    previewData = d;
    if (interludeOn && d.host !== lastShownHost) await interludeFacts(d);
    else { stage.classList.remove('on'); document.getElementById('preview')!.classList.remove('staging'); }
    lastShownHost = d.host;
    renderPreview(d);
    history.replaceState(null, '', '?pub=' + encodeURIComponent(d.host));
  } catch {
    stage.classList.remove('on');
    document.getElementById('preview')!.classList.remove('staging');
    document.getElementById('preview')!.classList.remove('personalized');
    document.getElementById('preview')!.classList.add('on');
    tryerr.textContent = 'Could not reach the preview service. The signup below works without it.';
    tryhandoff.hidden = false;
  } finally {
    trybtn.disabled = false; trybtn.textContent = 'Show my book';
  }
}
function renderPreview(d: any){
  const publicPosts = d.public_posts ?? d.posts;
  const cadence = d.cadence || (d.est_pages > 300 ? 'Quarterly' : 'Annual');
  const volumePages = d.volume_pages || (cadence === 'Quarterly' ? Math.round(d.est_pages / 4) : d.est_pages);
  (document.getElementById('pv-kind') as HTMLElement).textContent = cadence + ' · ' + d.to.slice(0,4);
  (document.getElementById('pv-mast') as HTMLElement).textContent = d.publication;
  (document.getElementById('pv-dates') as HTMLElement).textContent = fmt(d.from) + ' – ' + fmt(d.to);
  (document.getElementById('pv-cvpages') as HTMLElement).textContent = d.est_pages > 300
    ? 'Vol. I of IV · est. ' + volumePages + ' pages'
    : publicPosts + (d.capped ? '+' : '') + ' ' + kindLabel(d, publicPosts) + ' · est. ' + d.est_pages + ' pages';
  (document.getElementById('pv-spine') as HTMLElement).textContent = d.publication + ' · ' + d.to.slice(0,4);
  const over = d.est_pages > 300;

  /* the cover keeps the classic ivory style for every publication; web palettes stay on the web */
  /* their titles become the contents page */
  const toc = document.getElementById('pv-toc')!;
  (document.getElementById('pv-runname') as HTMLElement).textContent = d.publication;
  const rows = (d.sample && d.sample.length ? d.sample.map((x: any) => x.t) : (d.titles || [])).slice(0, 6);
  const step = Math.max(3, Math.round(d.est_pages / Math.max(publicPosts, 1)));
  let folio = 9;
  toc.innerHTML = rows.map((t: string, i: number) => {
    const line = '<div class="toc-line" style="transition-delay:' + (0.45 + i * 0.12) + 's">' +
      '<span class="t"></span><span class="dots"></span><span class="n">' + folio + '</span></div>';
    folio += step;
    return line;
  }).join('');
  [...toc.querySelectorAll('.t')].forEach((el, i) => (el as HTMLElement).textContent = rows[i]);



  /* staged assembly: cover lands, then the spine thickens to their page count */
  const block = document.getElementById('pv-block') as HTMLElement;
  block.style.width = '5px';
  requestAnimationFrame(() => requestAnimationFrame(() => {
    block.style.width = Math.max(5, Math.min(14, Math.round(d.est_pages / 22))) + 'px';
  }));
  const recD = d.divisions && d.recommended && d.divisions[d.recommended.cadence];
  (document.getElementById('pv-big') as HTMLElement).innerHTML =
    recD && recD.volumes.length > 1
    ? ((d.young || d.capped) ? 'Your archive so far is ' : 'Your year is ') + (d.form || 'a set') + ': <b>' + (d.capped ? 'about ' : '') + recD.volumes.length + ' ' + (d.unit || 'volume') + 's</b>.'
    : over
    ? 'Your year is ' + (d.capped ? 'at least ' : '') + 'a <b>' + d.est_pages.toLocaleString('en-US') + '-page shelf</b>.'
    : 'Your archive is already ' + (d.capped ? 'at least ' : '') + 'a <b>' + d.est_pages + '-page book</b>.';
  (document.getElementById('pv-sub') as HTMLElement).textContent =
    publicPosts + (d.capped ? '+' : '') + ' public ' + kindLabel(d, publicPosts) + ', ' +
    d.words.toLocaleString('en-US') + ' words, ' + fmt(d.from) + ' to ' + fmt(d.to) + '. ' +
    (d.paid_posts ? d.paid_posts + ' paid ' + (d.paid_posts === 1 ? 'post is' : 'posts are') + ' counted separately and can enter through your export. ' : '') +
    (d.podcast_posts ? d.podcast_posts + ' podcast ' + (d.podcast_posts === 1 ? 'post is' : 'posts are') + ' left out of the print estimate. ' : '') +
    (d.capped ? 'This preview read your newest ' + publicPosts + ' ' + kindLabel(d, publicPosts) + '; the printed edition uses them all. Pages and prices below are estimates until we read the rest. ' : '') +
    (recD && recD.volumes.length > 1
      ? 'That is ' + (d.capped ? 'about ' : '') + recD.volumes.length + ' ' + (d.unit || 'volume') + 's of ' +
        Math.min(...recD.volumes.map((v: any) => v.est_pages)) + ' to ' +
        Math.max(...recD.volumes.map((v: any) => v.est_pages)) + ' pages.'
      : 'Typeset at 6×9 with contents, running headers and your own cover.');
  renderDesk(d);
  renderSnippet(d);
  const pv = document.getElementById('preview')!;
  pv.classList.remove('on');
  void (pv as HTMLElement).offsetWidth;
  pv.classList.add('on', 'personalized');
  revealBook(d);
}
/* The reveal must land on the book: scroll it to the top of the viewport, move focus to it
   so keyboard and screen-reader users arrive where sighted users are looking, and announce
   the result once. Reduced-motion users get the same landing without the smooth scroll. */
function revealBook(d: any){
  const bw = document.getElementById('bookwrap') as HTMLElement;
  const status = document.getElementById('pv-status') as HTMLElement;
  const recD = d.divisions && d.recommended && d.divisions[d.recommended.cadence];
  const pages = recD && recD.volumes.length > 1
    ? recD.volumes.length + ' ' + unitOf(d, recD.volumes.length)
    : d.est_pages + ' pages';
  status.textContent = 'Your book is ready: ' + (d.capped ? 'about ' : '') + pages + '.';
  const smooth = matchMedia('(prefers-reduced-motion: no-preference)').matches;
  bw.focus({ preventScroll: true });
  bw.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
}

/* ---------- the composing desk: all the math done, defaults pre-set ---------- */
const PRICES = JSON.parse(document.getElementById('print-prices')!.textContent!);
let desk: any = null;
const CAD_LABEL: any = { single: 'One volume', quarterly: 'Quarterly', monthly: 'Monthly' };
function priceFor(pages: number, interior: string){
  const c = PRICES[interior === 'color' ? 'color' : 'bw'];
  return c.base + c.per_page * pages;
}
function unitOf(d: any, n: number){ return (d.unit || 'volume') + (n === 1 ? '' : 's'); }
function shipFor(n: number){
  const pts = Object.entries(PRICES.shipping_set || {}).map(([k, v]) => [Number(k), Number(v)]);
  if (!pts.length) return PRICES.shipping;
  const exact = pts.find(([k]) => k === n);
  if (exact) return exact[1];
  /* least-squares line through the measured points; shipping scales near-linearly per volume */
  const m = pts.length, sx = pts.reduce((a, [x]) => a + x, 0), sy = pts.reduce((a, [, y]) => a + y, 0);
  const sxx = pts.reduce((a, [x]) => a + x * x, 0), sxy = pts.reduce((a, [x, y]) => a + x * y, 0);
  const slope = (m * sxy - sx * sy) / (m * sxx - sx * sx), base = (sy - slope * sx) / m;
  return Math.max(PRICES.shipping, base + slope * n);
}
function aUnit(d: any){ const u = d.unit || 'volume'; return (/^[aeiou]/.test(u) ? 'an ' : 'a ') + u; }
function renderDesk(d: any){
  const el = document.getElementById('desk') as HTMLElement;
  const reason = document.getElementById('pv-reason') as HTMLElement;
  if (!d.divisions || !d.recommended){
    el.hidden = true; reason.textContent = '';
    (document.getElementById('pv-price') as HTMLElement).innerHTML =
      'Estimated printing: <b>about $' + Math.round(priceFor(d.est_pages, 'bw')) + '</b>' +
      '<span class="sub">Shipping and tax are calculated by Lulu.</span>';
    return;
  }
  const feasible = ['single','quarterly','monthly'].filter(k => d.divisions[k] && d.divisions[k].feasible);
  const startCadence = d.divisions[d.recommended.cadence] && d.divisions[d.recommended.cadence].feasible
    ? d.recommended.cadence : feasible[0];
  desk = { cadence: startCadence, interior: d.recommended.interior, d };
  el.hidden = false;
  if (!startCadence){
    document.getElementById('desk-tabs')!.innerHTML = '';
    document.getElementById('foliobar')!.innerHTML = '';
    document.getElementById('interior-row')!.innerHTML = '';
    (document.getElementById('pv-price') as HTMLElement).textContent = '';
    document.getElementById('desk-verdict')!.textContent =
      'This archive does not divide cleanly on its own; reserve a spot and we will plan the volumes by hand.';
    return;
  }
  const publicPosts = d.public_posts ?? d.posts;
  reason.textContent = 'What we read: ' + publicPosts + ' ' + kindLabel(d, publicPosts) + ' · ' +
    d.words.toLocaleString('en-US') + ' words · ' + fmt(d.from) + ' – ' + fmt(d.to);
  drawDesk();
}
function drawDesk(){
  const d = desk.d;
  const tabs = document.getElementById('desk-tabs')!;
  tabs.innerHTML = '';
  for (const key of ['single','quarterly','monthly']){
    const div = d.divisions[key];
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'desk-tab'; b.setAttribute('role','tab');
    b.setAttribute('aria-selected', String(desk.cadence === key));
    if (d.recommended.cadence === key){
      const fl = document.createElement('span'); fl.className = 'fl'; fl.textContent = '\u2766';
      b.appendChild(fl);
    }
    b.appendChild(document.createTextNode(CAD_LABEL[key]));
    if (!div.feasible){ b.disabled = true; b.title = div.reason || 'not printable'; }
    else b.addEventListener('click', () => { desk.cadence = key; beacon('plan_cadence'); drawDesk(); });
    tabs.appendChild(b);
  }
  const div = d.divisions[desk.cadence];
  const bar = document.getElementById('foliobar')!;
  bar.innerHTML = '';
  for (const v of div.volumes){
    const seg = document.createElement('div'); seg.className = 'folio-seg';
    seg.setAttribute('role','listitem');
    seg.setAttribute('aria-label', v.label + ', ' + v.est_pages + ' pages, about $' + Math.round(priceFor(v.est_pages, desk.interior)));
    seg.style.flexGrow = String(v.est_pages);
    const l1 = document.createElement('div'); l1.className = 'fs-dates'; l1.textContent = v.label;
    const l2 = document.createElement('div'); l2.className = 'fs-pages'; l2.textContent = v.est_pages + 'pp';
    const l3 = document.createElement('div'); l3.className = 'fs-price';
    l3.textContent = 'about $' + Math.round(priceFor(v.est_pages, desk.interior));
    seg.append(l1, l2, l3);
    bar.appendChild(seg);
  }
  const n = div.volumes.length;
  const verdict = document.getElementById('desk-verdict')!;
  let vtext = (desk.cadence === d.recommended.cadence ? 'Our recommendation: ' : 'Your pick: ') +
    (n === 1 ? 'one ' + (d.unit || 'volume') + ' of ' + (d.capped ? 'about ' : '') + div.volumes[0].est_pages + ' pages.'
     : (d.capped ? 'about ' : '') + n + ' ' + unitOf(d, n) + ' of ' +
       Math.min(...div.volumes.map((v: any) => v.est_pages)) + ' to ' +
       Math.max(...div.volumes.map((v: any) => v.est_pages)) + ' pages.');
  if (n > 1) vtext += ' Each volume carries its own front matter.';
  const ruled = ['single','quarterly','monthly'].find(k => !d.divisions[k].feasible);
  if (ruled) vtext += ' ' + CAD_LABEL[ruled] + ' is ruled out: ' + d.divisions[ruled].reason + '.';
  verdict.textContent = vtext;
  const avg = div.volumes.reduce((s: number, v: any) => s + v.est_pages, 0) / n;
  const row = document.getElementById('interior-row')!;
  row.innerHTML = '';
  for (const [key, name] of [['color','Colour'],['bw','Black & white']] as const){
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'int-opt';
    b.setAttribute('aria-pressed', String(desk.interior === key));
    b.textContent = name + ' · about $' + Math.round(priceFor(avg, key)) + ' ' + aUnit(d);
    b.addEventListener('click', () => { desk.interior = key; beacon('plan_interior'); drawDesk(); });
    row.appendChild(b);
  }
  const ship = shipFor(n);
  /* measured set sizes (1, 2, 4, 8) print exact; a fitted count, or a capped read, says "about" */
  const shipMeasured = Object.keys(PRICES.shipping_set || {}).map(Number).includes(n) && !d.capped;
  (document.getElementById('pv-price') as HTMLElement).textContent =
    'Readers pay print cost plus ' + (shipMeasured ? '$' + ship.toFixed(2) : 'about $' + Math.round(ship)) +
    (n > 1 ? ' shipping for the set' : ' shipping') + ', mainland US. ' +
    'Beta editions sell at cost; your margin comes at launch.';
  updateCoverFromDesk(d, div);
}
function updateCoverFromDesk(d: any, div: any){
  const n = div.volumes.length;
  const year = d.to.slice(0, 4);
  const kindTitle = (d.kind || 'collected').charAt(0).toUpperCase() + (d.kind || 'collected').slice(1);
  (document.getElementById('pv-kind') as HTMLElement).textContent =
    desk.cadence === 'single'
    ? (d.young ? kindTitle : 'Annual') + ' · ' + year
    : (desk.cadence === 'quarterly' ? 'Quarterly' : 'Monthly') + ' · ' + year;
  const publicPosts = d.public_posts ?? d.posts;
  (document.getElementById('pv-cvpages') as HTMLElement).textContent = n > 1
    ? 'Vol. I of ' + n + ' · ' + div.volumes[0].est_pages + ' pages'
    : publicPosts + (d.capped ? '+' : '') + ' ' + kindLabel(d, publicPosts) + ' · est. ' + div.volumes[0].est_pages + ' pages';
}
function renderSnippet(d: any){
  const wrap = document.getElementById('snippet') as HTMLElement;
  if (!wrap) return;
  wrap.hidden = false;
  (document.getElementById('snip-code') as HTMLElement).textContent =
    '<a href="https://inksheaf.com/?pub=' + d.host + '">Preview a print edition of ' + d.publication + '</a>';
}
document.getElementById('snip-copy')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget as HTMLButtonElement;
  try {
    await navigator.clipboard.writeText(document.getElementById('snip-code')!.textContent || '');
    btn.textContent = 'Copied'; setTimeout(() => { btn.textContent = 'Copy the code'; }, 1600);
  } catch { btn.textContent = 'Select and copy above'; }
});
function kindLabel(d: any, count: number){
  if (count === 1) return d.noun || 'piece';
  return d.kind || ((d.noun || 'piece') + 's');
}
function fmt(iso: string){
  return new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', {month:'short', year:'numeric', timeZone:'UTC'});
}
trybtn.addEventListener('click', ()=>runPreview());
tryurl.addEventListener('keydown', (e)=>{ if (e.key==='Enter'){ e.preventDefault(); runPreview(); } });
{ /* a preview someone shares reproduces itself */
  const pub = new URLSearchParams(location.search).get('pub');
  if (pub && /^[a-z0-9.-]+$/i.test(pub)){ tryurl.value = 'https://' + pub; runPreview(); }
}

tryhandoff.addEventListener('click', ()=>{
  const raw = tryurl.value.trim();
  if (raw) (f.elements.namedItem('publication_url') as HTMLInputElement).value =
    raw.startsWith('http') ? raw : 'https://' + raw;
  document.getElementById('carried')!.textContent =
    'We will build this preview by hand. Leave one email for the proof pages.';
  show(2);
  document.getElementById('beta')!.scrollIntoView({behavior:'smooth', block:'start'});
});

(document.getElementById('pv-cta') as HTMLButtonElement).addEventListener('click', ()=>{
  const d = previewData;
  if (d && desk && d.divisions){
    const div = desk.cadence && d.divisions[desk.cadence];
    (f.elements.namedItem('cadence_pref') as HTMLInputElement).value = desk.cadence || 'concierge';
    (f.elements.namedItem('plan_json') as HTMLInputElement).value = JSON.stringify({
      cadence: desk.cadence || 'concierge', interior: desk.interior,
      volumes: div && div.feasible ? div.volumes : [],
      needs_hand_plan: !(div && div.feasible) || undefined,
      form: d.form, unit: d.unit, prices_measured: PRICES.measured });
  }
  if (d){
    (f.elements.namedItem('publication_url') as HTMLInputElement).value = 'https://' + d.host;
    const publicPosts = d.public_posts ?? d.posts;
    (f.elements.namedItem('posts_per_year') as HTMLInputElement).value = String(publicPosts);
    (f.elements.namedItem('frequency') as HTMLInputElement).value =
      publicPosts >= 200 ? 'daily' : publicPosts >= 40 ? 'weekly' : publicPosts >= 10 ? 'monthly' : 'irregular';
    document.getElementById('carried')!.textContent =
      d.publication + ' · ' + d.est_pages + ' estimated pages. Leave one email for the first proof pages.';
    show(2);
  }
  document.getElementById('beta')!.scrollIntoView({behavior:'smooth'});
});

/* ---------- funnel ---------- */
f.addEventListener('keydown', (e)=>{
  if (e.key !== 'Enter') return;
  const target = e.target as HTMLElement;
  if (target.tagName === 'BUTTON' || target.tagName === 'SELECT') return;
  const current = [1,2].find(k => (f.querySelector('.step'+k) as HTMLElement).style.display !== 'none');
  if (current && current < 2){
    e.preventDefault();
    (f.querySelector('.step'+current+' [data-next]') as HTMLElement)?.click();
  }
});
f.addEventListener('click', (e)=>{
  const t = e.target as HTMLElement;
  const next = t.dataset?.next, back = t.dataset?.back;
  if (back) return show(+back);
  if (!next) return;
  if (next==='2'){
    const u = (f.elements.namedItem('publication_url') as HTMLInputElement).value.trim();
    try { new URL(u.startsWith('http')?u:'https://'+u); } catch {
      document.getElementById('err')!.textContent = 'That does not look like a URL.';
      return;
    }
    if (!u.startsWith('http')) (f.elements.namedItem('publication_url') as HTMLInputElement).value = 'https://'+u;
  }
  show(+next);
});
f.addEventListener('submit', async (e)=>{
  e.preventDefault();
  const email = (f.elements.namedItem('email') as HTMLInputElement).value.trim();
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){
    document.getElementById('err')!.textContent = 'That email does not look right.';
    return;
  }
  const data = Object.fromEntries(new FormData(f).entries());
  const r = await fetch('/api/signup', {method:'POST',
    headers:{'content-type':'application/json'}, body: JSON.stringify(data)});
  if (r.ok){
    beacon('signup');
    (f as HTMLElement).style.display='none';
    (document.querySelector('.steps') as HTMLElement).style.display='none';
    document.getElementById('done')!.style.display='block';
  } else {
    document.getElementById('err')!.textContent = 'Something failed on our side. Email caithrin@caithrin.com and we will add you by hand.';
  }
});
</script>
<script>
/* touch devices cannot hover: a tap opens the book */
const bw = document.getElementById('bookwrap');
if (bw){
  const toggle = () => {
    bw.classList.toggle('open');
    bw.setAttribute('aria-pressed', String(bw.classList.contains('open')));
  };
  if (matchMedia('(hover: none)').matches) bw.addEventListener('click', toggle);
  bw.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); toggle(); }
  });
}
</script>
