    : over
    ? 'Your year is ' + (d.capped ? 'at least ' : '') + 'a <b>' + d.est_pages.toLocaleString('en-US') + '-page shelf</b>.'
    : 'Your archive is already ' + (d.capped ? 'at least ' : '') + 'a <b>' + d.est_pages + '-page book</b>.';
  if (!ED) (document.getElementById('pv-sub') as HTMLElement).textContent =
    publicPosts + (d.capped ? '+' : '') + ' public ' + kindLabel(d, publicPosts) + ', ' +
    d.words.toLocaleString('en-US') + ' words, ' + fmt(d.from) + ' to ' + fmt(d.to) + '. ' +
    (d.paid_posts ? d.paid_posts + ' paid ' + (d.paid_posts === 1 ? 'post is' : 'posts are') + ' counted separately and can enter through your export. ' : '') +
    (d.podcast_posts ? d.podcast_posts + ' podcast ' + (d.podcast_posts === 1 ? 'post is' : 'posts are') + ' left out of the print estimate. ' : '') +
    (d.capped ? 'This preview read your newest ' + publicPosts + ' ' + kindLabel(d, publicPosts) + '; the printed edition uses them all. Pages and prices below are estimates until we read the rest. ' : '') +
    (recD && recD.volumes.length > 1
      ? 'That is ' + (d.capped ? 'about ' : '') + recD.volumes.length + ' ' + (d.unit || 'volume') + 's of ' +
        Math.min(...recD.volumes.map((v: any) => v.est_pages)) + ' to ' +
        Math.max(...recD.volumes.map((v: any) => v.est_pages)) + ' pages.'
      : 'Typeset at 6×9 with contents, running headers and your own cover.');
  renderDesk(d);
  renderSnippet(d);
  const pv = document.getElementById('preview')!;
  pv.classList.remove('on');
