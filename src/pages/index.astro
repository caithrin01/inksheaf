    (n === 1 ? 'one ' + (d.unit || 'volume') + ' of ' + (d.capped ? 'about ' : '') + div.volumes[0].est_pages + ' pages.'
     : (d.capped ? 'about ' : '') + n + ' ' + unitOf(d, n) + ' of ' +
       Math.min(...div.volumes.map((v: any) => v.est_pages)) + ' to ' +
       Math.max(...div.volumes.map((v: any) => v.est_pages)) + ' pages.');
  if (n > 1) vtext += ' Each volume carries its own front matter.';
  const ruled = ['single','quarterly','monthly'].find(k => !d.divisions[k].feasible);
  if (ruled) vtext += ' ' + CAD_LABEL[ruled] + ' is ruled out: ' + d.divisions[ruled].reason + '.';
  verdict.textContent = vtext;
  const avg = div.volumes.reduce((s: number, v: any) => s + v.est_pages, 0) / n;
