<body>
<script is:inline type="application/json" id="print-prices" set:html={JSON.stringify({ measured: prices.measured, shipping: prices.shipping_mail, shipping_set: prices.shipping_by_volumes, bw: { base: prices.pods.bw.base, per_page: prices.pods.bw.per_page }, color: { base: prices.pods.color.base, per_page: prices.pods.color.per_page } })}></script>
<ScrollHero />
<div class="sheet">
  <main>

    <section class="preview" id="preview" aria-label="Book preview">
      <p class="sr-only" id="pv-status" role="status" aria-live="polite"></p>
      <div class="pv-stage" id="pv-stage" aria-hidden="true">
        <div class="setkick">Setting your edition</div>
        <div class="setline" id="pv-setline">Reading your archive&hellip;</div>
        <div class="setrule"></div>
        <div class="presslog"><span>collating essays</span><span>measuring words</span><span>casting off pages</span><span>setting the cover</span></div>
      </div>

      <PreviewBook />

      <div class="pv-facts">
        <div class="pv-reason" id="pv-reason"></div>
        <div class="pv-big" id="pv-big"></div>
        <p class="pv-sub" id="pv-sub"></p>
        <div class="pv-price" id="pv-price"></div>
        <button class="pv-cta" id="pv-cta" type="button">Reserve this print run</button>
        <p class="pv-note note">Nothing prints until you approve your proof. Readers order from Lulu.</p>
        <div class="desk" id="desk" hidden>
          <p class="plan-what" id="plan-what"></p>
          <div class="desk-tabs" id="desk-tabs" role="tablist" aria-label="Ways to bind it"></div>
          <div id="plan-details" role="tabpanel" aria-label="Selected binding">
          <p class="route-why" id="route-why"></p>
          <div class="shelf foliobar" id="foliobar" role="list" aria-label="The volumes"></div>
          <div class="desk-verdict note" id="desk-verdict"></div>
          <p class="plan-progress note" id="plan-progress"></p>
          <div class="interior-row" id="interior-row" aria-label="Interior printing"></div>
          <p class="interior-why note" id="interior-why"></p>
          <p class="plan-by note" id="plan-by"></p>
          </div>
        </div>

      </div>
    </section>

    <section class="section faq">
      <h2 class="shead">Questions writers ask</h2>
      <div class="rule-orn" aria-hidden="true"><span>&#10086;</span></div>
      <details open>
        <summary>What does it cost me?</summary>
        <p>Nothing. It&rsquo;s free during the beta. Readers pay the printer per copy: a 294-page book came to $16.58 on a real order, and thinner books cost less. On Lulu&rsquo;s print API a 200-page volume prints for $6.99 in black and white, $10.83 in colour; shipping starts at $5.69 in the mainland US.</p>
      </details>
      <details>
        <summary>Is there a real one I can hold?</summary>
        <p>Yes, mine. I typeset my own Substack first so the problems would be mine before they were yours. The caithrin.com edition: 40 essays from January 2025 to August 2026, 294 pages at 6×9, on sale at its $9.34 print cost, which is what I chose to list it at: <a href="https://www.lulu.com/shop/caithrin-rintoul/caithrin-collected-essays-20252026/paperback/product-m2v2e82.html">caithrin &mdash; Collected Essays 2025&ndash;2026</a>. Readers pay the printer directly. These are pages from its print file.</p>
        <div class="realspread">
          <figure>
            <img src="/spread-toc-real.jpg" alt="Actual contents spread from the caithrin edition" loading="lazy" width="1800" height="1359" />
            <figcaption><b>Plate I.</b> &nbsp;Contents spread</figcaption>
          </figure>
          <figure>
            <img src="/spread-real.jpg" alt="Actual essay spread with running headers and article notes" loading="lazy" width="1800" height="1359" />
            <figcaption><b>Plate II.</b> &nbsp;Essay spread: running headers, article notes</figcaption>
          </figure>
        </div>
      </details>
      <details>
        <summary>What do I earn?</summary>
        <p>Whatever you set. List at print cost or add a margin, and the margin is yours. Beta editions default to cost while we build payouts with the beta authors on real numbers; we won&rsquo;t promise a rate before we can pay it.</p>
      </details>
      <details>
        <summary>Who owns the writing?</summary>
        <p>You. Nothing prints until you approve the proof, and we confirm permissions and takedown terms with you in writing before an edition is listed.</p>
      </details>
      <details>
        <summary>Is every book perfect bound?</summary>
        <p>Yes, a 6×9 paperback every time. We recommend volumes under 300 pages and refuse any past 800; a longer archive becomes a quarterly set of thinner books. Hardcover later, if beta writers ask for it.</p>
      </details>
      <details>
        <summary>How do paid posts get in without my password?</summary>
        <p>You download the export Substack makes in your own dashboard (Settings &rarr; Exports) and send it to us. Any subscriber files inside it we delete unread; only the posts are kept.</p>
      </details>
      <details>
        <summary>What happens to images, tweets and embeds?</summary>
        <p>The renderer lists every missing image and swaps web-only embeds (tweets, videos) for a printed source note. We go through that list and the proof with you before printing.</p>
      </details>
      <details>
        <summary>When do the first books exist?</summary>
        <p>We&rsquo;re aiming for December printing, so books arrive around New Year. If the date moves, you hear it from us directly.</p>
      </details>
      <details>
        <summary>Where can I read more?</summary>
        <p>Write to <a href="mailto:caithrin@caithrin.com">caithrin@caithrin.com</a>; every message gets an answer. I&rsquo;m writing up the build as it goes on <a href="https://www.caithrin.com">caithrin.com</a>.</p>
      </details>
    </section>

    <div class="faq-return">
      <button type="button" data-hero-try>Try it for my Stack <span class="return-caret" aria-hidden="true"></span></button>
    </div>

    <section class="section feedback" id="feedback" aria-label="Tell us what you think">
      <h2 class="shead">Tell us what you think</h2>
      <div class="rule-orn" aria-hidden="true"><span>&#10086;</span></div>
      <p class="fb-lede">This is a beta and every remark is read. What confused you, what you wanted, what you would change: a sentence is enough.</p>
      <noscript><p class="fb-lede">Send your note to <a href="mailto:caithrin@caithrin.com">caithrin@caithrin.com</a>.</p></noscript>
      <form id="fb-form" novalidate>
        <label class="fb-label" for="fb-text">Your note</label>
        <textarea id="fb-text" name="text" rows="4" maxlength="4000" required placeholder="The page turn is lovely, but I could not tell which edition I was reserving."></textarea>
        <label class="fb-label" for="fb-email">Your email, if you want a reply <span class="fb-opt">(optional)</span></label>
        <input id="fb-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" />
        <input class="fb-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="fb-row"><button class="fb-send" id="fb-send" type="submit">Send the note</button><span class="fb-status" id="fb-status" role="status" aria-live="polite"></span></div>
      </form>
    </section>

    <section class="beta" id="beta">
      <h2 class="shead">Join the private beta</h2>
      <div class="rule-orn" aria-hidden="true"><span>&#10086;</span></div>
      <div class="steps">Step <b id="stepnum">1</b> of 2</div>
      <noscript><p style="text-align:center">This form needs JavaScript. Without it, write to <a href="mailto:caithrin@caithrin.com">caithrin@caithrin.com</a> and we will add you by hand.</p></noscript>
      <form id="f" novalidate>
        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="step1">
          <label for="url">Your publication&rsquo;s URL</label>
          <input type="url" id="url" name="publication_url" placeholder="https://yourname.substack.com" required />
          <button type="button" class="main" data-next="2">Continue</button>
        </div>
        <div class="step2">
          <div class="prefilled" id="carried"></div>
          <label for="email">Where should we send the first proof pages?</label>
          <input type="email" id="email" name="email" required />
          <input type="hidden" name="posts_per_year" id="ppy" />
          <input type="hidden" name="frequency" />
          <input type="hidden" name="cadence_pref" id="cadence_pref" />
          <input type="hidden" name="plan_json" id="plan_json" />
          <button type="submit" class="main">Request a spot</button>
          <button type="button" class="ghost" data-back="1">Back</button>
        </div>
        <div class="err" id="err" role="alert"></div>
      </form>
      <div class="done" id="done">
        <h3 id="done-h">Your print run is reserved. One more step: confirm from your publication's inbox.</h3>
        <p id="done-verify">We sent a confirmation link to <b id="done-to">your publication's Substack address</b>, the address your newsletter sends from; Substack forwards it to the publication's owner. Open it and the proof is made. Nothing is printed or sent until then. If it does not arrive in ten minutes, write to caithrin@caithrin.com and we will confirm you another way.</p>
        <p>We reply to every signup within a few days with the timeline and, if your archive is public, the first proof pages of your own edition. Want to skip the queue? Reply with a link to the one post you&rsquo;d most like to see on paper.</p>
        <div id="done-alt" style="display:none">
          <button type="button" class="ghost" id="alt-start">Prove it another way</button>
          <p class="note" id="alt-text" style="display:none">Put this line anywhere on your publication&rsquo;s About page and save it: <b id="alt-code"></b>. Then press Check. Remove the line afterwards. The code is good for two days.</p>
          <button type="button" class="ghost" id="alt-check" style="display:none">Check</button>
          <p class="note" id="alt-result" role="status"></p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="rule-orn" aria-hidden="true"><span>&#10087;</span></div>
    <img class="markfoot" src="/brand/mark.svg" alt="" width="31" height="44" />
    <p class="legal">Inksheaf prints editions of Substack publications with their owners&rsquo; permission. It is an
    independent product, for Substack writers, and is not affiliated with or endorsed by Substack Inc.
    US delivery during the beta. Built by <a href="https://about.caithrin.com">Caithrin</a> &middot; <a href="mailto:caithrin@caithrin.com">caithrin@caithrin.com</a></p>
    <div class="setline2">Set in EB Garamond &middot; printed on demand by Lulu</div>
  </footer>
</div>

<script>
const f = document.getElementById('f') as HTMLFormElement;
let sid = Math.random().toString(36).slice(2,10);
try { sid = sessionStorage.getItem('inksheaf_sid') || sid; sessionStorage.setItem('inksheaf_sid', sid); } catch { /* Private storage restrictions must not stop a preview. */ }
const seen = new Set();
let aboutTimer: ReturnType<typeof setTimeout> | null = null;
function beacon(ev: string, host = ''){
  const key = ev + ':' + host.toLowerCase();
  if (seen.has(key)) return; seen.add(key);
  navigator.sendBeacon?.('/api/event', new Blob(
    [JSON.stringify({session:sid, event:ev, host, automated:navigator.webdriver === true})], {type:'application/json'}));
}
beacon('view');
function show(n: number){
  if (aboutTimer) clearTimeout(aboutTimer);
  f.style.display = 'block';
  (document.querySelector('.steps') as HTMLElement).style.display = 'block';
  document.getElementById('done')!.style.display = 'none';
  document.getElementById('done-alt')!.style.display = 'none';
  for (const k of [1,2]) (f.querySelector('.step'+k) as HTMLElement).style.display = (k===n?'block':'none');
  document.getElementById('stepnum')!.textContent = String(n);
  document.getElementById('err')!.textContent = '';
  if (n>1){
    beacon('step'+n);
    const pub = (f.elements.namedItem('publication_url') as HTMLInputElement)?.value || previewData?.host || '';
    if (pub) beacon('reserve_start', pub);
  }
}
show(1);

/* ---------- live preview ---------- */
const trybtn = document.getElementById('trybtn') as HTMLButtonElement;
const tryurl = document.getElementById('tryurl') as HTMLInputElement;
const tryerr = document.getElementById('tryerr')!;
const tryhandoff = document.getElementById('tryhandoff') as HTMLButtonElement;
let previewData: any = null;

/* ---------- visible status for the actual archive request ---------- */
const stage = document.getElementById('pv-stage')!;
function stageOff(){ stage.classList.remove('on'); document.getElementById('tryworking')!.textContent = ''; }
function interludeStart(){
  const pv = document.getElementById('preview')!;
  pv.classList.remove('on'); pv.classList.add('staging');
  const line = document.getElementById('pv-setline')!;
  line.textContent = 'Reading your archive…'; line.classList.add('in');
  document.getElementById('tryworking')!.textContent = 'Reading your archive…';
  stage.classList.add('on');
}

async function runPreview(){
  if (trybtn.disabled) return;
  const raw = tryurl.value.trim();
  if (!raw){ tryerr.textContent = 'Paste your publication URL first.'; return; }
  editorAsk = null;
  show(1);
  document.getElementById('carried')!.textContent = '';
  (f.elements.namedItem('publication_url') as HTMLInputElement).value = raw.startsWith('http') ? raw : 'https://' + raw;
  for (const name of ['plan_json','cadence_pref','posts_per_year','frequency']) (f.elements.namedItem(name) as HTMLInputElement).value = '';
  (document.getElementById('pv-cta') as HTMLButtonElement).disabled = true;
  tryerr.textContent = '';
  tryhandoff.hidden = true;
  trybtn.disabled = true; trybtn.textContent = 'Reading…';
  interludeStart();
  /* the server's relay budget is 40s; the page gives up at 45s and offers the hand-built route */
  const ctl = new AbortController();
  const abortTimer = setTimeout(() => ctl.abort(), 45000);
  try {
    const r = await fetch('/api/preview?url=' + encodeURIComponent(raw), { signal: ctl.signal });
    const d = await r.json();
    if (!d.ok){
      clearPreview();
      beacon('preview_fail', raw);
      (f.elements.namedItem('publication_url') as HTMLInputElement).value =
        raw.startsWith('http') ? raw : 'https://' + raw;
      stageOff();
      document.getElementById('preview')!.classList.remove('staging');
      document.getElementById('preview')!.classList.remove('personalized');
      document.getElementById('preview')!.classList.add('on');
      tryerr.textContent = d.message || 'Could not read that archive.';
      tryhandoff.hidden = false;
      return;
    }
    previewData = d;
    beacon('preview_ok', d.host);
    stageOff(); document.getElementById('preview')!.classList.remove('staging');
    renderPreview(d);
    history.replaceState(null, '', '?pub=' + encodeURIComponent(d.host));
  } catch (e) {
    clearPreview();
    beacon('preview_fail', raw);
    stageOff();
    document.getElementById('preview')!.classList.remove('staging');
    document.getElementById('preview')!.classList.remove('personalized');
    document.getElementById('preview')!.classList.add('on');
    tryerr.textContent = (e as any)?.name === 'AbortError'
      ? 'That archive is taking too long to read. Send it below and we will build the preview by hand.'
      : 'Could not reach the preview service. The signup below works without it.';
    tryhandoff.hidden = false;
  } finally {
    clearTimeout(abortTimer);
    trybtn.disabled = false; trybtn.textContent = 'Show my book';
    (document.getElementById('pv-cta') as HTMLButtonElement).disabled = false;
  }
}
function clearPreview(){
  previewData = null; plan = null; desk = null; editorAsk = null;
  for (const name of ['plan_json','cadence_pref','posts_per_year','frequency'])
    (f.elements.namedItem(name) as HTMLInputElement).value = '';
  document.getElementById('pv-status')!.textContent = '';
  document.getElementById('pv-mast')!.textContent = 'Your publication';
  document.getElementById('pv-kind')!.textContent = 'Your collected edition';
  document.getElementById('pv-dates')!.textContent = 'A preview of your writing';
  document.getElementById('pv-cvpages')!.textContent = '6 × 9 · perfect bound';
  document.getElementById('pv-spine')!.textContent = 'Your publication';
  document.getElementById('pv-runname')!.textContent = 'Your publication';
  document.getElementById('pv-toc')!.replaceChildren();
  (document.querySelector('.cover') as HTMLElement).removeAttribute('style');
  document.getElementById('book-text')!.textContent = '';
  document.getElementById('book-text')!.hidden = true;
  document.getElementById('bookwrap')!.classList.remove('open');
  document.getElementById('bookwrap')!.setAttribute('aria-pressed', 'false');
  document.getElementById('bookwrap')!.setAttribute('aria-label', 'Open the book to look inside');
}
/* One edition, one set of numbers (Codex, production journey 2026-09-04: the cover, the
   description, the announcement and the price disagreed because the rolling twelve-month read
   and the editor's complete-year plan were painted by different functions). When a plan with a
   route exists, that route is the edition everywhere; the rolling read is used only before or
   without one. `cadence` picks the route the visitor selected on the desk. */
function editionView(d: any, cadence?: string | null){
  const ed = d.editorial, P = ed && ed.plan, w = ed && ed.window;
  const routes = (P && P.routes) || [];
  const route = routes.find((r: any) => cadence && r.cadence === cadence) || routes.find((r: any) => r.recommended) || routes[0];
  if (route && route.volumes && route.volumes.length && w){
    const pages = route.volumes.reduce((a: number, v: any) => a + (Number(v.est_pages) || 0), 0);
    const posts = route.volumes.reduce((a: number, v: any) => a + (v.posts ?? v.post_ids?.length ?? 0), 0);
    const words = route.volumes.every((v: any) => Number.isFinite(v.words))
      ? route.volumes.reduce((a: number, v: any) => a + v.words, 0) : null;
    return { source: 'plan', route, cadence: route.cadence, span: w.span || (fmt(w.from) + ' – ' + fmt(w.to)), label: w.label || '', year: String(w.to || d.to).slice(0, 4),
      posts, words, pages, volumes: route.volumes.length, capped: !!d.capped };
  }
  const key = cadence || (desk?.d.host === d.host ? desk.cadence : null) || d.recommended?.cadence;
  const recD = d.divisions?.[key];
  const volumes = recD?.feasible ? recD.volumes : [];
  return { source: 'rolling', route: null, cadence: key, span: fmt(d.from) + ' – ' + fmt(d.to), label: '', year: String(d.to).slice(0, 4),
    posts: volumes.length && volumes.every((v: any) => Number.isFinite(v.posts)) ? volumes.reduce((a: number,v: any) => a+v.posts,0) : d.public_posts ?? d.posts,
    words: d.words, pages: volumes.length ? volumes.reduce((a: number,v: any) => a+v.est_pages,0) : d.est_pages,
    volumes: volumes.length || 1, capped: !!d.capped };

}
function sentence(text: string){
  const clean = String(text || '').trim().replace(/[.\s]+$/, '');
  return clean ? clean + (/[!?…]$/.test(clean) ? '' : '.') : '';
}
function announceEdition(d: any, E = editionView(d), prefix = 'Your book is ready: '){
  if (!document.getElementById('preview')!.classList.contains('personalized')) return;
  const needsHandPlan = d.editorial?.plan && !d.editorial.plan.routes.length;
  const text = needsHandPlan ? 'Your archive needs a hand-built plan. ' + E.posts + ' ' + kindLabel(d, E.posts) + ' read; request a proof to plan the volumes.' : prefix + E.posts + ' ' + kindLabel(d, E.posts) + ', ' +
    E.volumes + ' ' + unitOf(d, E.volumes) + ', ' + (E.capped ? 'about ' : '') + E.pages + ' estimated pages, ' + E.span + '.';
  const status = document.getElementById('pv-status')!;
  if (status.textContent !== text) status.textContent = text;
}
function paintEditionCopy(d: any, E: any){
  // Quantities describe the selected edition, including an editor's exclusions. Model
  // prose may describe another route or the source archive, so it cannot supply these.
  document.getElementById('pv-big')!.textContent = E.volumes === 1 ? 'Your writing, in one book.' : 'Your writing, in ' + E.volumes + ' ' + unitOf(d, E.volumes) + '.';
  document.getElementById('pv-sub')!.textContent = E.posts + ' ' + kindLabel(d, E.posts) + ', ' +
    (E.capped ? 'about ' : '') + E.pages + ' estimated pages. ' + E.span + '.' +
    (d.capped ? ' Pages and prices are estimates until we read the rest.' : '');
  const excluded = d.editorial?.plan?.excluded?.length || 0;
  const notes = [excluded ? excluded + ' archive ' + (excluded === 1 ? 'post is' : 'posts are') + ' left out of this edition; review the selection in your proof.' : '',
    d.paid_posts ? d.paid_posts + ' paid ' + (d.paid_posts === 1 ? 'post is' : 'posts are') + ' counted separately and can enter through your export.' : ''];
  document.getElementById('plan-what')!.textContent = notes.filter(Boolean).join(' ');
}
function paintCover(d: any, E: any){
  const cover = document.querySelector('.cover') as HTMLElement;
  const validHex = (v: any) => typeof v === 'string' && /^#[0-9a-f]{6}$/i.test(v);
  const bg = validHex(d.theme?.cover_bg) ? d.theme.cover_bg : '#f9f4e6';
  const luminance = (hex: string) => {
    const c = [1,3,5].map(i => parseInt(hex.slice(i,i+2),16)/255).map(v => v <= .04045 ? v/12.92 : ((v+.055)/1.055)**2.4);
    return c[0]*.2126+c[1]*.7152+c[2]*.0722;
  };
  const l = luminance(bg);
  const proposed = validHex(d.theme?.cover_ink) ? d.theme.cover_ink : '#211c15';
  const il = luminance(proposed);
  const ink = (Math.max(l,il)+.05)/(Math.min(l,il)+.05) >= 4.5 ? proposed : (l > .179 ? '#000000' : '#ffffff');
  cover.style.setProperty('--mast-size', d.publication.length > 55 ? '1.6rem' : d.publication.length > 30 ? '2rem' : '2.6rem');
  cover.style.setProperty('--cover-paper', bg);
  cover.style.setProperty('--cover-ink', ink);

  const kindName = E.source === 'plan' ? (E.cadence === 'single' ? (d.young ? 'Everything so far' : 'Annual') : CAD_NAME[E.cadence]) : (d.cadence || 'Annual');
  (document.getElementById('pv-kind') as HTMLElement).textContent = kindName + ' · ' + (E.label || E.year);
  (document.getElementById('pv-mast') as HTMLElement).textContent = d.publication;
