    const l1 = document.createElement('span'); l1.className = 'fs-dates'; l1.textContent = v.label;
    const l0 = document.createElement('span'); l0.className = 'fs-vol'; l0.textContent = route.volumes.length > 1 ? 'Vol. ' + (ROMAN[i] || i + 1) : (v.subtitle || '');
    sp.append(l0, l1);
    const pl = document.createElement('div'); pl.className = 'plaque';
    const l2 = document.createElement('div'); l2.className = 'fs-pages'; l2.textContent = (d.capped ? 'about ' : '') + v.est_pages + 'pp';
    const l3 = document.createElement('div'); l3.className = 'fs-price'; l3.textContent = money(price);
    pl.append(l2, l3);
    seg.append(sp, pl);
    bar.appendChild(seg);
  });
  const n = route.volumes.length;
  const lo = Math.min(...route.volumes.map((v: any) => v.est_pages)), hi = Math.max(...route.volumes.map((v: any) => v.est_pages));
  let vtext = (route.recommended ? 'Our recommendation: ' : 'Your pick: ') +
    (n === 1 ? 'one ' + (d.unit || 'volume') + ' of ' + (d.capped ? 'about ' : '') + lo + ' pages.'
     : (d.capped ? 'about ' : '') + n + ' ' + unitOf(d, n) + ' of ' + (d.capped ? 'about ' : '') + lo + ' to ' + hi + ' pages.');
  if (n > 1) vtext += ' Each volume carries its own title page, contents and notes.';
  for (const inf of P.infeasible) vtext += ' ' + CAD_NAME[inf.cadence] + ' is ruled out: ' + sentence(inf.reason);
  document.getElementById('desk-verdict')!.textContent = vtext;
  const ip = ed.window && ed.window.in_progress;
  (document.getElementById('plan-progress') as HTMLElement).textContent = ip
    ? (ip.posts ? ip.label + ' is in progress: ' + ip.posts + ' ' + kindLabel(d, ip.posts) + ' so far. They join the next edition.'
               : ip.label + ' has no posts yet; it opens the next edition.')
    : '';
  const row = document.getElementById('interior-row')!;
  row.innerHTML = '';
  for (const [key, name] of [['color','Colour'],['bw','Black & white']] as const){
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'int-opt';
    b.setAttribute('aria-pressed', String(plan.interior === key));
    if (P.interior.recommended === key){
      const fl = document.createElement('span'); fl.className = 'fl'; fl.textContent = '\u2766'; fl.setAttribute('aria-hidden', 'true'); b.appendChild(fl);
    }
    b.appendChild(document.createTextNode(name + ' · ' + money(route.price[key] / n) + ' ' + aUnit(d)));
    b.setAttribute('aria-label', name + ', ' + money(route.price[key] / n) + ' ' + aUnit(d) + (P.interior.recommended === key ? ', recommended' : ''));
    b.addEventListener('click', () => { plan.interior = key; beacon('plan_interior'); drawPlan(); });
    row.appendChild(b);
  }
  (document.getElementById('interior-why') as HTMLElement).textContent = P.interior.why;
  const ship = shipFor(n);
  const shipMeasured = Object.keys(PRICES.shipping_set || {}).map(Number).includes(n) && !d.capped;
  (document.getElementById('pv-price') as HTMLElement).textContent =
    'Estimated printing: ' + money(route.price[plan.interior]) + (n > 1 ? ' for the set' : ' per copy') +
    '. Shipping: ' + (shipMeasured ? '$' + ship.toFixed(2) : 'about $' + Math.round(ship)) + ', mainland US, to one address. At cost during the beta.';
  (document.getElementById('plan-by') as HTMLElement).textContent = ed.planned_by === 'editor' ? 'Planned by our editor from your archive' : (ed.pending ? 'Planned by the calendar · our editor is reading your archive' : 'Planned by the calendar');
  const E = editionView(d, plan.cadence);
  paintCover(d, E);
  paintEditionCopy(d, E);
  announceEdition(d, E);
  (document.getElementById('pv-cvpages') as HTMLElement).textContent = n > 1
    ? 'Vol. I of ' + n + ' · ' + route.volumes[0].label + ' · ' + route.volumes[0].est_pages + ' pages'
    : E.posts + ' ' + kindLabel(d, E.posts) + ' · est. ' + E.pages + ' pages';
  refreshCapturedReservation();
  if (activeGroup === 'desk-tabs') (tabs.querySelector('[aria-selected="true"]') as HTMLElement)?.focus({preventScroll:true});
  if (activeGroup === 'interior-row') (row.querySelector('[aria-pressed="true"]') as HTMLElement)?.focus({preventScroll:true});
