---
// One short, deliberate opening. The field keeps the stable hooks used by the reservation flow.
import motion from "../../public/motion/manifest.json";
const motionVersion = motion.lanes.desk.files["desk-opening.webp"].sha256.slice(0, 12) + motion.lanes.portrait.files["portrait-opening.webp"].sha256.slice(0, 12);
---
<header class="sheaf-header">
  <a class="sheaf-brand" href="#hero-story" aria-label="Inksheaf, back to the opening">
    <img src="/brand/mark.svg" alt="" width="26" height="26" />
    <b>Inksheaf</b>
  </a>
  <button class="sheaf-header-cta" id="hero-try" type="button" data-hero-try>
    Try it for my Stack <span aria-hidden="true">↗</span>
  </button>
</header>

<section class="sheaf-scroll" id="hero-story" data-motion-version={motionVersion} aria-label="How Inksheaf turns a newsletter into a book">
  <div class="sheaf-stage">
    <div class="sheaf-scene">
    <picture>
      <source media="(max-aspect-ratio: 4/5)" type="image/avif" srcset={"/motion/portrait-ready.avif?v=" + motionVersion} />
      <source type="image/avif" srcset={"/motion/desk-ready.avif?v=" + motionVersion} />
      <source media="(max-aspect-ratio: 4/5)" type="image/webp" srcset={"/motion/portrait-ready.webp?v=" + motionVersion} />
      <img class="sheaf-frame" id="hero-f3" src={"/motion/desk-ready.webp?v=" + motionVersion}
        alt="The same book open to its title page" width="1600" height="900" decoding="async" />
    </picture>
    <picture>
      <source media="(max-aspect-ratio: 4/5)" type="image/avif" srcset={"/motion/portrait-closed.avif?v=" + motionVersion} />
      <source type="image/avif" srcset={"/motion/desk-closed.avif?v=" + motionVersion} />
      <source media="(max-aspect-ratio: 4/5)" type="image/webp" srcset={"/motion/portrait-closed.webp?v=" + motionVersion} />
      <img class="sheaf-frame" id="hero-f0" src={"/motion/desk-closed.webp?v=" + motionVersion}
        alt="An ivory book on a lamplit walnut desk, with the Inksheaf sheaf engraved in the wood"
        width="1600" height="900" fetchpriority="high" decoding="async" />
    </picture>
    <img class="sheaf-frame sheaf-motion" id="hero-motion" alt="" aria-hidden="true" width="1600" height="900" />
    <div class="sheaf-vignette" aria-hidden="true"></div>

    <div class="sheaf-title" id="tryit">
      <h1>Your Substack,<br />bound as a book.</h1>
      <div class="sheaf-message-slot">
        <p class="sheaf-say">We find your writing, set it in type, and print it to order.</p>
        <div class="sheaf-working" id="tryworking" aria-live="polite"></div>
        <div class="sheaf-error" id="tryerr" role="alert"></div>
        <button class="sheaf-handoff" id="tryhandoff" type="button" hidden>Send me a hand-built preview</button>
      </div>
      <label for="tryurl">Your publication</label>
      <div class="sheaf-input-wrap">
        <input type="url" id="tryurl" placeholder="yourname.substack.com" autocomplete="url" autocapitalize="off" spellcheck="false" enterkeyhint="go" aria-describedby="tryerr" />
      </div>
      <noscript><p class="sheaf-say">For a hand-built preview, <a href="mailto:caithrin@caithrin.com">write to Caithrin</a>.</p></noscript>
      <div><button class="sheaf-go" id="trybtn" type="button">Show my book</button></div>
    </div>

    </div>
    <div class="sheaf-narration" aria-hidden="true">
      <div class="sheaf-line">Your Substack, as a book you can hold.</div>


    </div>

    <div class="sheaf-hint" id="hero-hint" aria-hidden="true">Scroll to open<span></span></div>
  </div>
</section>
<noscript>
  <style>
    /* no scripts: the settled title page, usable, and the specimen book below it (journey A13) */
    /* id-qualified so these outrank Astro's attribute-scoped component rules */
    .sheaf-header .sheaf-header-cta,#hero-story .sheaf-title label,#hero-story .sheaf-input-wrap,#hero-story .sheaf-go{display:none}
    #fb-form,.faq-return button,.bookhint{display:none}
    #bookwrap{cursor:default}
    #hero-story.sheaf-scroll{height:100vh;height:100svh}
    #hero-story .sheaf-stage{position:relative}
    #hero-story .sheaf-frame{display:none}
    #hero-story #hero-f3{display:block;opacity:1}
    #hero-story .sheaf-narration,#hero-story .sheaf-hint{display:none}
    #hero-story .sheaf-title{opacity:1;pointer-events:auto;transform:translateX(-50%)}
    #preview.preview{display:block}
    #preview .bookwrap,#preview .pv-page,#preview .pv-price,#preview .pv-page .toc-line{opacity:1;transform:none;animation:none}
  </style>
</noscript>

<style>
  .sheaf-header{position:fixed;top:0;left:0;right:0;z-index:60;display:flex;align-items:center;justify-content:space-between;
    gap:1rem;padding:.9rem clamp(1rem,4vw,2.4rem);background:linear-gradient(rgba(11,6,2,.74),rgba(11,6,2,0));
    backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}
  .sheaf-brand{display:flex;align-items:center;gap:.55rem;color:#eaddc2;text-decoration:none}
  .sheaf-brand img{filter:invert(1) sepia(.5) saturate(1.7) hue-rotate(349deg) brightness(1.05)}
  .sheaf-brand b{font-size:1.34rem;font-weight:600}
  .sheaf-header-cta{display:inline-flex;align-items:center;gap:.5rem;font:600 1.06rem/1 "EB Garamond",Garamond,serif;
    color:#f4ead4;background:#a8452c;border:0;border-radius:2px;padding:.8rem 1.45rem;cursor:pointer;
    box-shadow:0 2px 0 rgba(50,16,8,.5),0 10px 22px -8px rgba(140,50,26,.6);
    transition:transform .2s,box-shadow .2s}
  .sheaf-header-cta:hover{transform:translateY(-1px);box-shadow:0 3px 0 rgba(50,16,8,.5),0 13px 26px -8px rgba(140,50,26,.7)}
  .sheaf-header-cta:focus-visible,.sheaf-go:focus-visible,.sheaf-handoff:focus-visible,.sheaf-input-wrap:focus-within{
    outline:2px solid #f4ead4;outline-offset:4px}
  .sheaf-caret{display:inline-block;width:2px;height:1.05em;background:currentColor;animation:sheaf-blink 1.1s step-end infinite}
  @keyframes sheaf-blink{50%{opacity:0}}

  .sheaf-scroll{height:190svh;position:relative;background:#0b0602}
  .sheaf-stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;background:
    radial-gradient(100% 80% at 58% 16%,rgba(198,133,67,.28),transparent 58%),
    linear-gradient(132deg,#24170d 0%,#0b0602 72%)}
  .sheaf-scene{position:absolute;left:50%;top:50%;width:max(100%,177.778svh);aspect-ratio:16/9;transform:translate(-50%,-50%)}
  .sheaf-frame{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:none;pointer-events:none}
  .sheaf-stage picture{pointer-events:none}
  #hero-f0,#hero-f3{opacity:1}
  .sheaf-vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(120% 100% at 55% 46%,transparent 52%,rgba(0,0,0,.5))}

  .sheaf-narration{position:absolute;left:clamp(1.2rem,5vw,4.5rem);bottom:13vh;z-index:5;width:min(23ch,82vw)}
  .sheaf-line{position:absolute;left:0;bottom:0;width:100%;opacity:1;transform:none;
    font-size:clamp(24px,2.7vw,39px);line-height:1.14;color:#f2e6cd;font-weight:500;text-shadow:0 2px 18px rgba(0,0,0,.7)}

  .sheaf-title{position:absolute;left:72%;top:30%;width:20%;transform:translateX(-50%);max-width:420px;text-align:center;color:#2a2118;
    opacity:0;z-index:6;pointer-events:none}
  .sheaf-title h1{font-size:clamp(20px,min(2.3vw,3.8vh),32px);line-height:1.1;font-weight:600;margin:0;animation:none;text-shadow:none}
  .sheaf-say{font-size:clamp(13px,min(1.1vw,2vh),15px);font-style:italic;color:#4a3626;margin:8px auto 0;max-width:30ch;line-height:1.4}
  .sheaf-title label{display:block;font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:#a8452c;margin:13px 0 5px}
  .sheaf-input-wrap{display:inline-flex;align-items:center;gap:1px;max-width:100%;border-bottom:1.4px solid rgba(90,66,30,.55);padding-bottom:3px}
  .sheaf-input-wrap input{border:0;background:transparent;font-family:inherit;font-size:clamp(14px,min(1.15vw,2.1vh),16px);
    color:#2a2118;text-align:center;width:22ch;max-width:100%;outline:none;caret-color:#a8452c}
  .sheaf-input-wrap input::placeholder{color:rgba(42,33,24,.62)}
  .sheaf-input-wrap .sheaf-caret{color:#a8452c}
  .sheaf-go{min-height:44px;margin-top:11px;display:inline-block;border:1.1px solid #2a2118;padding:7px 20px;font:600 11px/1.3 "EB Garamond",Garamond,serif;
    letter-spacing:.2em;text-transform:uppercase;color:#2a2118;background:rgba(244,234,212,.4);cursor:pointer}
  .sheaf-go:hover{background:#2a2118;color:#f4ead4}
  .sheaf-input-wrap:focus-within{outline-color:#8e2f1c}
  .sheaf-go:focus-visible,.sheaf-handoff:focus-visible{outline-color:#8e2f1c}
  .sheaf-go:disabled{opacity:.55;cursor:wait}
  .sheaf-error{color:#8e2f1c;font-size:clamp(12px,min(1.05vw,1.9vh),14px);line-height:1.35;margin:8px auto 0;max-width:30ch}
  .sheaf-error:empty{display:none}
  /* while the archive is read, the pressroom's lines play here, where the visitor is looking */
  .sheaf-working{color:#4a3626;font-style:italic;font-size:clamp(13px,min(1.1vw,2vh),15px);line-height:1.4;margin:8px auto 0;max-width:30ch;min-height:1.4em}
  .sheaf-working:empty{display:none}
  .sheaf-message-slot{position:relative;min-height:4.9rem;margin-top:.5rem;display:grid;align-content:start}
  .sheaf-message-slot .sheaf-say,.sheaf-message-slot .sheaf-working,.sheaf-message-slot .sheaf-error{margin-top:0}
  .sheaf-title:has(.sheaf-working:not(:empty)) .sheaf-say,.sheaf-title:has(.sheaf-error:not(:empty)) .sheaf-say{display:none}
  .sheaf-title label{margin-top:0}
  .sheaf-motion{visibility:hidden}
  #hero-story[data-phase="opening"] .sheaf-motion{visibility:visible;opacity:1}
  #hero-story[data-phase="opening"] #hero-f0{opacity:0!important}
  #hero-story[data-image-fallback] .sheaf-title{background:#f4ead4;padding:1rem}

  .sheaf-working b{color:#a8452c;font-weight:600;font-style:normal}
  .sheaf-title:has(.sheaf-working:not(:empty)) .sheaf-say{display:none}
  /* a failure is one quiet line where the sub-line was, never the hero */
  .sheaf-title:has(.sheaf-error:not(:empty)) .sheaf-say{display:none}
  .sheaf-handoff{margin-top:4px;border:0;background:none;color:#8e2f1c;padding:0;font:600 clamp(12px,min(1.05vw,1.9vh),14px)/1.3 "EB Garamond",Garamond,serif;
    text-decoration:underline;text-underline-offset:2px;cursor:pointer}

  .sheaf-hint{position:absolute;left:50%;bottom:30px;transform:translateX(-50%);z-index:5;color:#d9c8a6;
    font-size:11.5px;letter-spacing:.24em;text-transform:uppercase;text-align:center}
  .sheaf-hint span{display:block;margin:8px auto 0;width:14px;height:14px;border-right:1.5px solid #d9c8a6;
    border-bottom:1.5px solid #d9c8a6;transform:rotate(45deg);animation:sheaf-bob 1.8s ease-in-out infinite}
  @keyframes sheaf-bob{0%,100%{transform:rotate(45deg) translate(0,0)}50%{transform:rotate(45deg) translate(3px,3px)}}

  @media (max-aspect-ratio:4/5){
    .sheaf-scroll{height:170svh}
    .sheaf-scene{width:max(100%,65.625svh);aspect-ratio:21/32}
    .sheaf-frame{object-position:50% 50%}
    .sheaf-title{left:55%;top:28%;width:48%;max-width:none;transform:translateX(-50%)}
    .sheaf-title h1{font-size:26px}.sheaf-say{font-size:15px}.sheaf-title label{font-size:10px}.sheaf-input-wrap input{font-size:16px}.sheaf-go{font-size:12px}
    .sheaf-narration{left:auto;right:7%;bottom:16%;width:48%}.sheaf-line{font-size:clamp(22px,4.3vw,28px)}
    .sheaf-header-cta{font-size:.96rem;padding:.7rem 1.05rem}.sheaf-brand b{font-size:1.16rem}
  }

  @media (max-aspect-ratio:4/5) and (max-height:650px){
    .sheaf-title h1{font-size:22px}.sheaf-say{font-size:13px}.sheaf-message-slot{min-height:3.5rem}
  }
  @media(max-width:380px){
    .sheaf-header{gap:.5rem}.sheaf-brand{gap:.4rem}.sheaf-brand img{width:22px}.sheaf-brand b{font-size:1.05rem}
    .sheaf-header-cta{font-size:.88rem;gap:.35rem;padding:.75rem .6rem;white-space:nowrap}
  }
  @media (prefers-reduced-motion:reduce){
    .sheaf-caret,.sheaf-hint span{animation:none}
    .sheaf-scroll{height:100vh;height:100svh}
    .sheaf-stage{position:relative}
    .sheaf-frame{display:none!important;will-change:auto;transform:none!important}
    #hero-f3{display:block!important;opacity:1!important}
    .sheaf-narration,.sheaf-hint{display:none}
    .sheaf-title{opacity:1!important;pointer-events:auto!important;transform:translateX(-50%)!important}
    .sheaf-header-cta{transition:none}
  }
  @media (max-height:500px) and (min-width:641px){
    .sheaf-title{top:30%;left:72%;width:20%}
    .sheaf-title h1{font-size:20px;line-height:1.05}
    .sheaf-say{display:none}
    .sheaf-message-slot{min-height:3.5rem;margin-top:.4rem}
    .sheaf-title label{margin:7px 0 3px;font-size:9px}
    .sheaf-input-wrap input{padding:2px 0;font-size:14px;line-height:1.3}
    .sheaf-go{min-height:44px;margin-top:7px;padding:7px 16px;font-size:10px}
    .sheaf-error,.sheaf-working,.sheaf-handoff{font-size:12px;line-height:1.3;margin-top:4px}
  }
  /* A software keyboard can leave less height than the photographic page needs. Keep the
     same field and action on a compact paper surface, with focus and input untouched. */
  @media(max-height:500px) and (max-width:640px){
    .sheaf-stage:has(.sheaf-title:focus-within){z-index:20}
    .sheaf-scene{transform:none;left:0;top:0;width:100%;height:100%;aspect-ratio:auto}
    .sheaf-title:focus-within{position:fixed}
    .sheaf-title{top:calc(50% + 20px);left:50%;width:min(86vw,340px);max-width:none;transform:translate(-50%,-50%);padding:.75rem 1rem;background:#f4ead4;border:1px solid #cfc3a9;box-shadow:0 8px 30px #0004}
    .sheaf-title h1{font-size:20px;line-height:1.1}.sheaf-say{display:none}
    .sheaf-message-slot{min-height:3.3rem;margin-top:.4rem}.sheaf-input-wrap input{font-size:16px;padding:4px 0}
    .sheaf-go{min-height:44px;margin-top:7px}.sheaf-title label{font-size:9px;margin-top:0}
    #hero-story .sheaf-title{transform:translate(-50%,-50%)!important}
  }
  @media (prefers-reduced-motion:reduce) and (max-aspect-ratio:4/5){
    .sheaf-title{transform:translateX(-50%)!important}
  }
</style>

<script is:inline>
(function(){
  const root=document.getElementById('hero-story');
  if(!root)return;
  const first=document.getElementById('hero-f0'),last=document.getElementById('hero-f3');
  const moving=document.getElementById('hero-motion'),title=document.getElementById('tryit');
  const field=document.getElementById('tryurl'),narration=root.querySelector('.sheaf-narration'),hint=document.getElementById('hero-hint');
  const reduced=matchMedia('(prefers-reduced-motion: reduce)'),portrait=matchMedia('(max-aspect-ratio: 4/5)');
  let phase='closed',timer=0,blob=null,objectURL=null,generation=0,openingCount=0,attempt=0;
  const duration=800;
  function paint(ready){
    first.style.opacity=ready?'0':'1';
    narration.style.opacity=ready?'0':'1';hint.style.opacity=ready?'0':'1';
    title.style.opacity=ready?'1':'0';title.style.pointerEvents=ready?'auto':'none';
  }
  function setPhase(next){phase=next;root.dataset.phase=next;}
  function release(){
    attempt++;clearTimeout(timer);moving.removeAttribute('src');
    if(objectURL){URL.revokeObjectURL(objectURL);objectURL=null;}
  }
  function settle(){
    if(!last.complete||!last.naturalWidth)root.dataset.imageFallback='true';
    setPhase('ready');paint(true);release();
  }
  function target(){return root.offsetTop+Math.max(0,root.offsetHeight-root.querySelector('.sheaf-stage').offsetHeight);}
  function focusTitle(){
    settle();window.scrollTo({top:target(),behavior:'instant'});
    field.focus({preventScroll:true});
  }
  async function prepare(){
    const version=++generation;blob=null;root.dataset.motionReady='false';
    if(reduced.matches||navigator.connection?.saveData)return;
    try{
      const asset=portrait.matches?'/motion/portrait-opening.webp':'/motion/desk-opening.webp';
      const response=await fetch(asset+'?v='+root.dataset.motionVersion,{cache:'force-cache',priority:'low'});
      if(!response.ok)return;
      const next=await response.blob();
      if(version===generation){blob=next;root.dataset.motionReady='true';}
    }catch{ /* The still title page is always usable without the motion asset. */ }
  }
  async function open(){
    if(phase!=='closed')return;
    if(reduced.matches||!blob){root.dataset.motionSkipped='true';settle();return;}
    const current=++attempt;setPhase('preparing');objectURL=URL.createObjectURL(blob);moving.src=objectURL;
    // A decoder failure or slow device must never hold the invitation hostage.
    timer=setTimeout(()=>{if(current===attempt&&phase==='preparing')settle();},200);
    try{await moving.decode();}catch{if(current===attempt&&phase==='preparing')settle();return;}
    if(current!==attempt||phase!=='preparing')return;
    clearTimeout(timer);setPhase('opening');root.dataset.openings=String(++openingCount);
    narration.style.opacity='0';hint.style.opacity='0';
    timer=setTimeout(settle,duration);
  }
  function sync(){
    if(reduced.matches){settle();return;}
    if(phase==='closed'&&scrollY-root.offsetTop>Math.min(100,innerHeight*.12))open();
  }
  document.addEventListener('click',event=>{
    if(event.target.closest?.('[data-hero-try]'))focusTitle();
    if(event.target.closest?.('.sheaf-brand')){
      event.preventDefault();release();setPhase(reduced.matches?'ready':'closed');paint(reduced.matches);
      delete root.dataset.motionSkipped;if(!reduced.matches&&!blob)prepare();window.scrollTo({top:root.offsetTop,behavior:'instant'});
    }
  });
  field.addEventListener('focus',()=>{if(phase!=='ready')focusTitle();});
  let queued=false;
  addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(()=>{queued=false;sync();});}},{passive:true});
  addEventListener('resize',sync,{passive:true});
  addEventListener('pageshow',()=>{if(scrollY>root.offsetTop+80)settle();});
  addEventListener('pagehide',release);
  document.addEventListener('visibilitychange',()=>{if(document.hidden&&(phase==='opening'||phase==='preparing'))settle();});
  portrait.addEventListener('change',()=>{
    if(phase==='opening'||phase==='preparing')settle();
    if(phase==='closed')prepare();else{generation++;blob=null;root.dataset.motionReady='false';}
  });
  reduced.addEventListener('change',()=>{if(reduced.matches)settle();else prepare();});
  // Keep the decoded title poster underneath the closed cover and moving image.
  // Revealing a previously transparent async image can otherwise flash the empty desk.
  function decodePoster(){last.decode().then(()=>{delete root.dataset.imageFallback;}).catch(()=>{root.dataset.imageFallback='true';});}
  last.addEventListener('load',decodePoster);
  last.addEventListener('error',()=>{root.dataset.imageFallback='true';});
  decodePoster();
  setPhase(reduced.matches?'ready':'closed');paint(reduced.matches);
  if(scrollY>root.offsetTop+80)settle();
  prepare();
})();
</script>
