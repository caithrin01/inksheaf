# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
proofs/*.pdf
proofs/*.html
node_modules/
dist/
.astro/
proofs/.cache/
# pipeline runtime artifacts (regenerable; proofs live on the private Modal store, never in public/)
public/*.pdf
proofs/pipe/**/*.pdf
proofs/pipe/**/*.img
proofs/pipe/**/*.html
.playwright-cli/
# Render masters stay local; storyboard prompts are the durable recipe and belong in git.
assets/*
!assets/storyboard/
assets/storyboard/*
!assets/storyboard/prompts/
!assets/storyboard/prompts/*.txt
.wrangler/
proofs/oversized-*
proofs/heavy-*
proofs/press/
.dev.vars

# overnight test-campaign and volume-orchestrator outputs (regenerable, never committed)
proofs/overnight/
proofs/vol/
proofs/*.typ
proofs/*.pages.json
proofs/fixtures/*.pdf
proofs/fixtures/*.typ
